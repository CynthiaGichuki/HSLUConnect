---
// src/layouts/Layout.astro
import "../styles/global.css";
import {
  Youtube,
  Instagram,
  Twitter,
} from "lucide-astro";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | HSLUConnect</title>
  </head>

  <body class="bg-brand-offwhite text-brand-black font-sans">
    <nav class="fixed top-6 left-0 w-full z-50 px-6">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-2 group shrink-0">
          <div class="w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center font-black text-brand-black group-hover:rotate-12 transition-transform">
            H
          </div>
          <span class="text-xl font-black tracking-tighter text-white">HSLUConnect</span>
        </a>

        <div class="hidden lg:flex items-center bg-white/90 backdrop-blur-md px-10 py-3 rounded-full shadow-xl border border-white/20 gap-8 mx-4">
          <a href="/" class="text-[10px] font-black hover:text-brand-primary transition uppercase tracking-[0.2em]">Home</a>
          <a href="/explore" class="text-[10px] font-black hover:text-brand-primary transition uppercase tracking-[0.2em]">Explore</a>
          <a href="/create" class="text-[10px] font-black hover:text-brand-primary transition uppercase tracking-[0.2em]">Host</a>
          <a href="/about" class="text-[10px] font-black hover:text-brand-primary transition uppercase tracking-[0.2em]">About Us</a>
          <a href="/contact" class="text-[10px] font-black hover:text-brand-primary transition uppercase tracking-[0.2em]">Contact</a>
        </div>

        <div class="flex items-center gap-6">
          <div class="hidden md:flex items-center gap-3">
            <a href="https://instagram.com" class="group">
              <div class="w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-brand-black group-hover:rotate-12 transition-transform shadow-lg">
                <Instagram size={18} strokeWidth={1.5} />
              </div>
            </a>

            <a href="https://youtube.com" class="group">
              <div class="w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-brand-black group-hover:rotate-12 transition-transform shadow-lg">
                <Youtube size={18} strokeWidth={1.5} />
              </div>
            </a>

            <a href="https://twitter.com" class="group">
              <div class="w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-brand-black group-hover:rotate-12 transition-transform shadow-lg">
                <Twitter size={18} strokeWidth={1.5} />
              </div>
            </a>
          </div>

          <a 
            id="login-link"
            href="/auth/login" 
            class="bg-brand-primary text-brand-black px-8 py-3 rounded-full font-black text-[10px] uppercase tracking-widest hover:bg-brand-white transition-all shadow-lg flex items-center gap-2 whitespace-nowrap"
          >
            Login
          </a>

          <a 
            id="register-link"
            href="/auth/register" 
            class="bg-brand-primary text-brand-black px-8 py-3 rounded-full font-black text-[10px] uppercase tracking-widest hover:bg-brand-white transition-all shadow-lg flex items-center gap-2 whitespace-nowrap"
          >
            Register
          </a>

          <button
            id="logout-button"
            class="hidden bg-brand-black text-brand-white px-8 py-3 rounded-full font-black text-[10px] uppercase tracking-widest hover:bg-brand-primary hover:text-brand-black transition-all shadow-lg whitespace-nowrap"
          >
            Logout
          </button>
        </div>

      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="text-center py-20 text-slate-400 text-[10px] font-black tracking-[0.3em] uppercase">
      &copy; 2026 MAITPRO Team A
    </footer>

    <script>
      import { supabase } from "../lib/supabase";

      const loginLink = document.getElementById("login-link") as HTMLAnchorElement;
      const registerLink = document.getElementById("register-link") as HTMLAnchorElement;
      const logoutButton = document.getElementById("logout-button") as HTMLButtonElement;

      async function updateNavbar() {
        const { data } = await supabase.auth.getSession();

        if (data.session) {
          loginLink.classList.add("hidden");
          registerLink.classList.add("hidden");
          logoutButton.classList.remove("hidden");
        } else {
          loginLink.classList.remove("hidden");
          registerLink.classList.remove("hidden");
          logoutButton.classList.add("hidden");
        }
      }

      logoutButton?.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/auth/login";
      });

      updateNavbar();
    </script>
  </body>
</html>