---
import Layout from '../../layouts/Layout.astro';
import { 
  LayoutDashboard, 
  Users, 
  Calendar, 
  Settings, 
  ShieldCheck, 
  Bell, 
  Search,
  ArrowUpRight,
  MoreHorizontal,
  Activity
} from 'lucide-astro';

const menuItems = [
  { name: 'Overview', icon: LayoutDashboard, active: true },
  { name: 'Events Control', icon: Calendar, active: false },
  { name: 'Student Directory', icon: Users, active: false },
  { name: 'Verification Queue', icon: ShieldCheck, active: false },
  { name: 'System Settings', icon: Settings, active: false },
];

const recentActivity = [
  { user: "Gauri Nair", action: "Created 'Study Night'", time: "2 mins ago" },
  { user: "Sparsh Sopory", action: "Verified 12 students", time: "1 hour ago" },
  { user: "System", action: "Database Backup Complete", time: "3 hours ago" },
];
---

<Layout title="Admin Panel">
  <div class="flex min-h-screen bg-white">
    
    <aside class="w-72 bg-brand-offwhite border-r border-black/5 flex flex-col fixed h-full pt-32 pb-10">
      <div class="px-8 mb-10">
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-brand-primary">Control Center</span>
      </div>
      
      <nav class="flex-grow px-4 space-y-2">
        {menuItems.map(item => (
          <a href="#" class={`flex items-center gap-4 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all ${
            item.active ? 'bg-white text-brand-black shadow-sm' : 'text-slate-400 hover:bg-white/50 hover:text-brand-primary'
          }`}>
            <item.icon size={18} strokeWidth={item.active ? 2.5 : 1.5} />
            {item.name}
          </a>
        ))}
      </nav>

      <div class="px-8 border-t border-black/5 pt-8">
        <div class="bg-brand-primary/10 rounded-2xl p-6">
          <p class="text-[9px] font-black text-brand-primary uppercase mb-2">Pro Version</p>
          <p class="text-[11px] text-brand-black font-medium leading-relaxed mb-4">You are using the MAITPRO Team A Prototype.</p>
          <button class="text-[9px] font-black uppercase text-brand-black border-b border-brand-black">View Docs</button>
        </div>
      </div>
    </aside>

    <main class="flex-grow ml-72 pt-32 px-12 pb-24">
      
      <div class="flex justify-between items-center mb-16">
        <div>
          <h1 class="text-4xl font-light text-brand-black tracking-tighter italic">Platform <span class="font-semibold text-brand-primary">Command</span></h1>
          <p class="text-slate-400 text-sm font-light mt-1">Welcome back, Admin Cynthia.</p>
        </div>
        
        <div class="flex items-center gap-4">
          <div class="relative">
            <Search class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300" size={16} />
            <input type="text" placeholder="Search data..." class="bg-brand-offwhite border-none rounded-full py-3 pl-12 pr-6 text-xs outline-none w-64 focus:ring-2 focus:ring-brand-primary/20 transition-all" />
          </div>
          <button class="w-12 h-12 bg-brand-offwhite rounded-full flex items-center justify-center text-slate-400 hover:text-brand-primary transition-colors border border-black/5">
            <Bell size={20} />
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="bg-white border border-black/5 p-8 rounded-[2.5rem] shadow-sm hover:shadow-xl transition-all">
          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Total RSVP's</p>
          <p class="text-5xl font-light italic text-brand-black">1,284</p>
          <div class="mt-4 flex items-center gap-2 text-green-500 text-[10px] font-bold">
            <ArrowUpRight size={14} /> +24% from last semester
          </div>
        </div>
        <div class="bg-white border border-black/5 p-8 rounded-[2.5rem] shadow-sm hover:shadow-xl transition-all">
          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Active Events</p>
          <p class="text-5xl font-light italic text-brand-black">56</p>
          <div class="mt-4 flex items-center gap-2 text-brand-primary text-[10px] font-bold">
            12 awaiting verification
          </div>
        </div>
        <div class="bg-brand-black p-8 rounded-[3rem] shadow-2xl text-white">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-primary mb-2">System Status</p>
          <p class="text-3xl font-light italic text-white">Operational</p>
          <div class="mt-6 flex gap-1">
            <div class="h-1 w-full bg-brand-primary rounded-full"></div>
            <div class="h-1 w-full bg-brand-primary rounded-full"></div>
            <div class="h-1 w-full bg-brand-primary/20 rounded-full"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <div class="bg-white rounded-[3rem] border border-black/5 p-10">
          <div class="flex justify-between items-center mb-10">
            <h3 class="text-xl font-bold italic tracking-tight">Recent Activity</h3>
            <MoreHorizontal size={20} class="text-slate-300" />
          </div>
          <div class="space-y-8">
            {recentActivity.map(item => (
              <div class="flex items-center justify-between border-b border-black/5 pb-6 last:border-0 last:pb-0">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 bg-brand-offwhite rounded-full flex items-center justify-center font-bold text-[10px] text-brand-primary">
                    {item.user.charAt(0)}
                  </div>
                  <div>
                    <p class="text-xs font-bold text-brand-black">{item.user}</p>
                    <p class="text-[11px] text-slate-400 font-light">{item.action}</p>
                  </div>
                </div>
                <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest">{item.time}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-brand-offwhite rounded-[3rem] border border-black/5 p-10 flex flex-col items-center justify-center text-center">
          <Activity size={48} strokeWidth={1} class="text-brand-primary mb-6" />
          <h3 class="text-lg font-bold italic text-brand-black mb-2">Data Analytics</h3>
          <p class="text-xs text-slate-500 font-light max-w-[200px]">Interactive charts for student engagement will be rendered here.</p>
        </div>

      </div>
    </main>
  </div>
</Layout>