---
import Layout from '../layouts/Layout.astro';
import { User, Mail, MapPin, ExternalLink, Settings, Plus, Calendar } from 'lucide-astro';

const myEvents = [
  { title: "Rooftop Mixer", date: "June 12", type: "Created" },
  { title: "AI Ethics Seminar", date: "June 15", type: "RSVP'd" },
  { title: "Lake Side Study Session", date: "June 18", type: "RSVP'd" }
];
---

<Layout title="My Profile">
  <div class="bg-white min-h-screen pt-40 pb-24">
    <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <aside class="lg:col-span-4 space-y-8">
        <div class="bg-brand-offwhite rounded-[3rem] p-10 border border-black/5 text-center">
          <div class="w-32 h-32 bg-brand-primary/20 rounded-full mx-auto mb-6 flex items-center justify-center text-brand-primary">
            <User size={64} strokeWidth={1} />
          </div>
          <h2 class="text-2xl font-light italic text-brand-black">Cynthia Gichuki</h2>
          <p class="text-[10px] uppercase font-black tracking-widest text-brand-primary mb-6">Master's Student</p>
          
          <div class="space-y-4 text-left border-t border-black/5 pt-8">
            <div class="flex items-center gap-3 text-xs font-medium text-slate-400">
              <Mail size={14} class="text-brand-primary" /> cynthia.gichuki@stud.hslu.ch
            </div>
            <div class="flex items-center gap-3 text-xs font-medium text-slate-400">
              <MapPin size={14} class="text-brand-primary" /> Campus Rotkreuz
            </div>
          </div>
          
          <button class="mt-10 w-full py-4 border border-black/5 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-black hover:text-white transition-all flex items-center justify-center gap-2">
            <Settings size={14} /> Edit Profile
          </button>
        </div>
      </aside>

      <main class="lg:col-span-8">
        <div class="flex justify-between items-center mb-12">
          <h3 class="text-4xl font-light text-brand-black tracking-tight italic">My <span class="font-semibold text-brand-primary">Schedule</span></h3>
          <a href="/create" class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest bg-brand-black text-white px-6 py-3 rounded-full hover:bg-brand-primary hover:text-brand-black transition-all">
            <Plus size={14} /> New Event
          </a>
        </div>

        <div class="space-y-4">
          {myEvents.map(event => (
            <div class="group bg-white hover:bg-brand-offwhite p-8 rounded-[2.5rem] border border-black/5 flex items-center justify-between transition-all">
              <div class="flex items-center gap-6">
                <div class={`w-12 h-12 rounded-2xl flex items-center justify-center ${event.type === 'Created' ? 'bg-brand-primary text-brand-black' : 'bg-brand-black text-white'}`}>
                  <Calendar size={20} />
                </div>
                <div>
                  <h4 class="text-xl font-light text-brand-black italic">{event.title}</h4>
                  <p class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">{event.date} • {event.type}</p>
                </div>
              </div>
              <a href="/explore" class="w-10 h-10 border border-black/5 rounded-full flex items-center justify-center text-slate-300 group-hover:text-brand-primary group-hover:border-brand-primary transition-all">
                <ExternalLink size={16} />
              </a>
            </div>
          ))}
        </div>
      </main>

    </div>
  </div>
</Layout>