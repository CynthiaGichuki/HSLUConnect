---
import Layout from '../layouts/Layout.astro';
import { User, Mail, MapPin, Settings, Plus, BookOpen } from 'lucide-astro';

const campusData = {
  Rotkreuz: [
    "MSc IT, Digitalisation & Sustainability",
    "BSc Computer Science",
    "BSc Artificial Intelligence",
    "BSc Immersive Technologies",
  ],
  Luzern: [
    "MSc Business Administration",
    "MSc Banking & Finance",
    "BSc International Business",
  ],
  Horw: ["BSc Engineering", "BSc Architecture"],
};
---

<Layout title="My Profile">
  <div class="bg-white min-h-screen pt-40 pb-24">
    <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <aside class="lg:col-span-4 space-y-8">
        <div class="bg-brand-offwhite rounded-[3rem] p-10 border border-black/5 text-center">
          <div class="w-32 h-32 bg-brand-primary/20 rounded-full mx-auto mb-6 flex items-center justify-center text-brand-primary">
            <User size={64} strokeWidth={1} />
          </div>

          <h2 id="profile-name" class="text-2xl font-light italic text-brand-black">Loading...</h2>
          <p id="profile-role" class="text-[10px] uppercase font-black tracking-widest text-brand-primary mb-6">
            Student
          </p>
          
          <div class="space-y-4 text-left border-t border-black/5 pt-8">
            <div class="flex items-center gap-3 text-xs font-medium text-slate-400">
              <Mail size={14} class="text-brand-primary" />
              <span id="profile-email">Loading...</span>
            </div>

            <div class="flex items-center gap-3 text-xs font-medium text-slate-400">
              <MapPin size={14} class="text-brand-primary" />
              <span id="profile-campus">Campus not added</span>
            </div>

            <div class="flex items-center gap-3 text-xs font-medium text-slate-400">
              <BookOpen size={14} class="text-brand-primary" />
              <span id="profile-programme">Programme not added</span>
            </div>
          </div>

          <p id="profile-bio" class="mt-8 text-sm text-slate-500 font-light leading-relaxed text-left hidden"></p>
          
          <button
            id="edit-profile-btn"
            class="mt-10 w-full py-4 border border-black/5 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-black hover:text-white transition-all flex items-center justify-center gap-2"
          >
            <Settings size={14} /> Edit Profile
          </button>
        </div>

        <div id="edit-profile-form-wrapper" class="hidden bg-white rounded-[3rem] p-8 border border-black/5">
          <h3 class="text-xl font-light italic text-brand-black mb-6">
            Edit <span class="font-semibold text-brand-primary">Profile</span>
          </h3>

          <form id="edit-profile-form" class="space-y-5">
            <input
              id="edit-full-name"
              type="text"
              placeholder="Full name"
              class="w-full bg-brand-offwhite rounded-2xl p-4 text-sm outline-none"
              required
            />

            <div class="relative">
              <MapPin
                size={16}
                class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300"
              />
              <select
                id="edit-campus"
                class="w-full bg-brand-offwhite rounded-2xl py-4 pl-12 pr-4 text-sm outline-none appearance-none cursor-pointer"
              >
                <option value="">Select your campus</option>
                {
                  Object.keys(campusData).map((campus) => (
                    <option value={campus}>{campus}</option>
                  ))
                }
              </select>
            </div>

            <div class="relative">
              <BookOpen
                size={16}
                class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300"
              />
              <select
                id="edit-programme"
                disabled
                class="w-full bg-brand-offwhite rounded-2xl py-4 pl-12 pr-4 text-sm outline-none appearance-none cursor-pointer disabled:opacity-50"
              >
                <option value="">Choose campus first</option>
              </select>
            </div>

            <textarea
              id="edit-bio"
              rows="4"
              placeholder="Bio"
              class="w-full bg-brand-offwhite rounded-2xl p-4 text-sm outline-none resize-none"
            ></textarea>

            <p id="edit-message" class="hidden text-xs font-medium"></p>

            <div class="flex gap-3">
              <button
                id="cancel-edit-btn"
                type="button"
                class="w-1/2 py-4 bg-brand-offwhite text-brand-black rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-slate-100 transition-all"
              >
                Cancel
              </button>

              <button
                id="save-profile-btn"
                type="submit"
                class="w-1/2 py-4 bg-brand-black text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-primary hover:text-brand-black transition-all disabled:opacity-60 disabled:cursor-not-allowed"
              >
                Save
              </button>
            </div>
          </form>
        </div>
      </aside>

      <main class="lg:col-span-8">
        <div class="flex justify-between items-center mb-12">
          <div>
            <h3 class="text-4xl font-light text-brand-black tracking-tight italic">
              My <span class="font-semibold text-brand-primary">Schedule</span>
            </h3>
            <p id="schedule-status" class="text-sm text-slate-400 font-light mt-2">
              Loading your events...
            </p>
          </div>

          <a href="/create" class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest bg-brand-black text-white px-6 py-3 rounded-full hover:bg-brand-primary hover:text-brand-black transition-all">
            <Plus size={14} /> New Event
          </a>
        </div>

        <div id="events-list" class="space-y-4"></div>
      </main>

    </div>
  </div>

  <script>
    import { supabase } from "../lib/supabase";

    const campusMap = {
      Rotkreuz: [
        "MSc IT, Digitalisation & Sustainability",
        "BSc Computer Science",
        "BSc Artificial Intelligence",
        "BSc Immersive Technologies",
      ],
      Luzern: [
        "MSc Business Administration",
        "MSc Banking & Finance",
        "BSc International Business",
      ],
      Horw: ["BSc Engineering", "BSc Architecture"],
    };

    type Profile = {
      id: string;
      full_name: string | null;
      email: string | null;
      programme: string | null;
      campus: string | null;
      bio: string | null;
      role: string | null;
    };

    type EventItem = {
      id: string;
      title: string;
      event_date: string;
      event_time: string | null;
      event_type: string;
      category: string | null;
      location: string | null;
      created_by: string;
    };

    const profileName = document.getElementById("profile-name") as HTMLHeadingElement;
    const profileRole = document.getElementById("profile-role") as HTMLParagraphElement;
    const profileEmail = document.getElementById("profile-email") as HTMLSpanElement;
    const profileCampus = document.getElementById("profile-campus") as HTMLSpanElement;
    const profileProgramme = document.getElementById("profile-programme") as HTMLSpanElement;
    const profileBio = document.getElementById("profile-bio") as HTMLParagraphElement;
    const eventsList = document.getElementById("events-list") as HTMLDivElement;
    const scheduleStatus = document.getElementById("schedule-status") as HTMLParagraphElement;

    const editProfileBtn = document.getElementById("edit-profile-btn") as HTMLButtonElement;
    const editProfileWrapper = document.getElementById("edit-profile-form-wrapper") as HTMLDivElement;
    const editProfileForm = document.getElementById("edit-profile-form") as HTMLFormElement;
    const cancelEditBtn = document.getElementById("cancel-edit-btn") as HTMLButtonElement;
    const saveProfileBtn = document.getElementById("save-profile-btn") as HTMLButtonElement;

    const editFullName = document.getElementById("edit-full-name") as HTMLInputElement;
    const editProgramme = document.getElementById("edit-programme") as HTMLSelectElement;
    const editCampus = document.getElementById("edit-campus") as HTMLSelectElement;
    const editBio = document.getElementById("edit-bio") as HTMLTextAreaElement;
    const editMessage = document.getElementById("edit-message") as HTMLParagraphElement;

    let currentProfile: Profile | null = null;

    function populateProgrammeOptions(campus: string, selectedProgramme = "") {
      const programmes = campusMap[campus as keyof typeof campusMap] ?? [];

      editProgramme.disabled = programmes.length === 0;
      editProgramme.innerHTML = programmes.length === 0
        ? '<option value="">Choose campus first</option>'
        : '<option value="">Select your programme</option>';

      programmes.forEach((programme) => {
        const option = document.createElement("option");
        option.value = programme;
        option.textContent = programme;
        option.selected = programme === selectedProgramme;
        editProgramme.appendChild(option);
      });
    }

    function escapeHtml(value: string) {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatDate(dateValue: string) {
      return new Date(dateValue).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      });
    }

    function formatTime(timeValue: string | null) {
      if (!timeValue) return "";
      return ` at ${timeValue.slice(0, 5)}`;
    }

    function renderProfile(profile: Profile, authEmail: string | undefined) {
      currentProfile = profile;

      profileName.textContent = profile.full_name || "HSLU Student";
      profileRole.textContent = profile.role === "admin" ? "Admin" : "Master's Student";
      profileEmail.textContent = profile.email || authEmail || "Email not available";
      profileCampus.textContent = profile.campus || "Campus not added";
      profileProgramme.textContent = profile.programme || "Programme not added";

      if (profile.bio) {
        profileBio.textContent = profile.bio;
        profileBio.classList.remove("hidden");
      } else {
        profileBio.textContent = "";
        profileBio.classList.add("hidden");
      }
    }

    function fillEditForm() {
      if (!currentProfile) return;

      editFullName.value = currentProfile.full_name ?? "";
      editCampus.value = currentProfile.campus ?? "";
      populateProgrammeOptions(editCampus.value, currentProfile.programme ?? "");
      editBio.value = currentProfile.bio ?? "";

      editMessage.textContent = "";
      editMessage.classList.add("hidden");
    }

    editCampus.addEventListener("change", () => {
      populateProgrammeOptions(editCampus.value);
    });

    function showEditMessage(text: string, type: "error" | "success") {
      editMessage.textContent = text;
      editMessage.classList.remove("hidden", "text-red-500", "text-green-600");
      editMessage.classList.add(type === "error" ? "text-red-500" : "text-green-600");
    }

    editProfileBtn.addEventListener("click", () => {
      fillEditForm();

      const wasHidden = editProfileWrapper.classList.contains("hidden");

      editProfileWrapper.classList.toggle("hidden");

      if (wasHidden) {
        setTimeout(() => {
          editProfileWrapper.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }, 100);
      }
    });

    cancelEditBtn.addEventListener("click", () => {
      editProfileWrapper.classList.add("hidden");
      fillEditForm();
    });

    editProfileForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const { data: sessionData } = await supabase.auth.getSession();
      const user = sessionData.session?.user;

      if (!user) {
        window.location.href = "/auth/login";
        return;
      }

      const updatedProfile = {
        full_name: editFullName.value.trim(),
        programme: editProgramme.value.trim() || null,
        campus: editCampus.value.trim() || null,
        bio: editBio.value.trim() || null,
      };

      if (!updatedProfile.full_name) {
        showEditMessage("Please enter your full name.", "error");
        return;
      }

      saveProfileBtn.disabled = true;
      saveProfileBtn.textContent = "Saving...";

      const { data, error } = await supabase
        .from("profiles")
        .update(updatedProfile)
        .eq("id", user.id)
        .select("id, full_name, email, programme, campus, bio, role")
        .single();

      saveProfileBtn.disabled = false;
      saveProfileBtn.textContent = "Save";

      if (error) {
        showEditMessage(error.message, "error");
        return;
      }

      renderProfile(data as Profile, user.email);
      showEditMessage("Profile updated successfully.", "success");

      setTimeout(() => {
        editProfileWrapper.classList.add("hidden");
      }, 900);
    });

    function renderEvents(events: Array<EventItem & { schedule_type: "Created" | "RSVP'd" }>) {
      if (events.length === 0) {
        scheduleStatus.textContent = "You have not created or joined any events yet.";
        eventsList.innerHTML = "";
        return;
      }

      scheduleStatus.textContent = `${events.length} event${events.length === 1 ? "" : "s"} in your schedule`;

      eventsList.innerHTML = events.map((event) => {
        const iconClass = event.schedule_type === "Created"
          ? "bg-brand-primary text-brand-black"
          : "bg-brand-black text-white";

        return `
          <div class="group bg-white hover:bg-brand-offwhite p-8 rounded-[2.5rem] border border-black/5 flex items-center justify-between transition-all">
            <div class="flex items-center gap-6">
              <div class="w-12 h-12 rounded-2xl flex items-center justify-center ${iconClass}">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-light text-brand-black italic">${escapeHtml(event.title)}</h4>
                <p class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">
                  ${formatDate(event.event_date)}${formatTime(event.event_time)} • ${event.schedule_type}
                </p>
              </div>
            </div>

            <a href="/events/event_details?id=${event.id}" class="w-10 h-10 border border-black/5 rounded-full flex items-center justify-center text-slate-300 group-hover:text-brand-primary group-hover:border-brand-primary transition-all">
              ↗
            </a>
          </div>
        `;
      }).join("");
    }

    async function loadProfilePage() {
      const { data: sessionData } = await supabase.auth.getSession();
      const user = sessionData.session?.user;

      if (!user) {
        window.location.href = "/auth/login";
        return;
      }

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("id, full_name, email, programme, campus, bio, role")
        .eq("id", user.id)
        .single();

      if (profileError) {
        scheduleStatus.textContent = profileError.message;
        return;
      }

      renderProfile(profile as Profile, user.email);

      const { data: createdEvents, error: createdError } = await supabase
        .from("events")
        .select("id, title, event_date, event_time, event_type, category, location, created_by")
        .eq("created_by", user.id)
        .order("event_date", { ascending: true });

      if (createdError) {
        scheduleStatus.textContent = createdError.message;
        return;
      }

      const { data: rsvpRows, error: rsvpError } = await supabase
        .from("event_rsvps")
        .select("event_id")
        .eq("user_id", user.id)
        .eq("status", "going");

      if (rsvpError) {
        scheduleStatus.textContent = rsvpError.message;
        return;
      }

      const rsvpEventIds = (rsvpRows ?? []).map((row) => row.event_id);

      let rsvpEvents: EventItem[] = [];

      if (rsvpEventIds.length > 0) {
        const { data, error } = await supabase
          .from("events")
          .select("id, title, event_date, event_time, event_type, category, location, created_by")
          .in("id", rsvpEventIds)
          .order("event_date", { ascending: true });

        if (error) {
          scheduleStatus.textContent = error.message;
          return;
        }

        rsvpEvents = data ?? [];
      }

      const created = (createdEvents ?? []).map((event) => ({
        ...event,
        schedule_type: "Created" as const,
      }));

      const rsvpd = rsvpEvents
        .filter((event) => event.created_by !== user.id)
        .map((event) => ({
          ...event,
          schedule_type: "RSVP'd" as const,
        }));

      const combinedEvents = [...created, ...rsvpd].sort((a, b) => {
        return new Date(a.event_date).getTime() - new Date(b.event_date).getTime();
      });

      renderEvents(combinedEvents);
    }

    loadProfilePage();
  </script>
</Layout>
