---
import Layout from '../layouts/Layout.astro';
import { MapPin, Calendar, Users, Filter, ArrowRight, Search } from 'lucide-astro';

const events = [
  { 
    title: "International Student Mixer", 
    type: "Public", 
    category: "Social", 
    date: "April 10, 2026", 
    location: "Campus Zug-Rotkreuz",
    spots: 50 
  },
  { 
    title: "Project Management Workshop", 
    type: "Official", 
    category: "Academic", 
    date: "April 15, 2026", 
    location: "Online (Zoom)",
    spots: 100 
  },
  { 
    title: "Secret Fondue Night", 
    type: "Private", 
    category: "Social", 
    date: "April 18, 2026", 
    location: "Invite Only",
    spots: 10 
  }
];
---

<Layout title="Explore Events">
  <div class="max-w-7xl mx-auto px-8 pt-40 pb-24">
    <header class="mb-16">
      <h1 class="text-5xl md:text-6xl font-light text-brand-black tracking-tighter mb-4 italic">
        Find your <span class="font-semibold text-brand-primary">Experience</span>
      </h1>
      <p class="text-slate-400 font-light text-lg max-w-xl">
        Centralized access to informal social events and official HSLU workshops.
      </p>
    </header>

    <section class="flex flex-wrap items-center gap-8 mb-16 py-6 border-y border-black/5">
      <div class="flex items-center gap-3 text-brand-black/40 uppercase text-[10px] font-black tracking-[0.3em]">
        <Filter size={14} strokeWidth={2.5} />
        Filter
      </div>

      <div class="flex gap-2">
        <button class="px-6 py-2.5 bg-brand-black text-brand-white rounded-full text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-brand-primary hover:text-brand-black">
          All
        </button>
        <button class="px-6 py-2.5 bg-brand-offwhite text-brand-black rounded-full text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-brand-primary/20">
          Public
        </button>
        <button class="px-6 py-2.5 bg-brand-offwhite text-brand-black rounded-full text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-brand-primary/20">
          Official
        </button>
      </div>

      <div class="flex-1 min-w-[300px] md:ml-auto relative group">
        <Search size={16} class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-brand-primary transition-colors" />
        <input 
          type="text" 
          placeholder="Search by keyword, location, or type..." 
          class="w-full bg-brand-offwhite border border-transparent focus:border-brand-primary/30 focus:bg-white rounded-full py-3 pl-12 pr-6 text-sm font-light transition-all outline-none"
        />
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      {events.map(event => (
        <div class="group bg-white rounded-[3rem] border border-black/5 p-10 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-700 flex flex-col min-h-[500px]">
          
          <div class="flex justify-between items-start mb-10">
            <span class={`text-[9px] uppercase tracking-[0.2em] font-black px-4 py-2 rounded-full ${
              event.type === 'Official' ? 'bg-brand-black text-brand-white' : 'bg-brand-primary text-brand-black'
            }`}>
              {event.type}
            </span>
            <span class="text-[9px] font-black uppercase tracking-widest text-black/20 group-hover:text-brand-primary transition-colors italic">
              {event.category}
            </span>
          </div>

          <div class="flex-grow">
            <h3 class="text-3xl font-light text-brand-black leading-tight mb-8 group-hover:text-brand-primary transition-colors uppercase tracking-tighter italic">
              {event.title}
            </h3>
            
            <div class="space-y-5">
              <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
                <MapPin size={16} strokeWidth={1} class="text-brand-primary" />
                {event.location}
              </div>
              <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
                <Calendar size={16} strokeWidth={1} class="text-brand-primary" />
                {event.date}
              </div>
              <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
                <Users size={16} strokeWidth={1} class="text-brand-primary" />
                {event.spots} Spots Available
              </div>
            </div>
          </div>

          <button class="mt-12 w-full group/btn flex items-center justify-between py-5 px-8 bg-brand-offwhite rounded-2xl text-brand-black font-black uppercase text-[10px] tracking-[0.2em] hover:bg-brand-black hover:text-brand-white transition-all shadow-sm">
            Join Event
            <ArrowRight size={18} class="group-hover/btn:translate-x-2 transition-transform" />
          </button>
        </div>
      ))}
    </div>
  </div>
</Layout>