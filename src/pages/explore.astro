---
import Layout from '../layouts/Layout.astro';
import { ChevronDown, Filter, Search } from 'lucide-astro';
---

<Layout title="Explore Events">
  <div class="max-w-7xl mx-auto px-8 pt-40 pb-24">
    <header class="mb-16">
      <h1 class="text-5xl md:text-6xl font-light text-brand-black tracking-tighter mb-4 italic">
        Find your <span class="font-semibold text-brand-primary">Experience</span>
      </h1>
      <p class="text-slate-400 font-light text-lg max-w-xl">
        Centralized access to informal social events and official HSLU workshops.
      </p>
    </header>

    <section class="mb-16 py-6 border-y border-black/5">
      <div class="flex flex-wrap items-center gap-4">
        <div id="filter-menu" class="relative">
          <button
            id="filter-menu-btn"
            type="button"
            aria-expanded="false"
            class="h-12 inline-flex items-center gap-3 bg-brand-black text-brand-white rounded-full px-6 text-[10px] font-black uppercase tracking-[0.25em] hover:bg-brand-primary hover:text-brand-black transition-all"
          >
            <Filter size={14} strokeWidth={2.5} />
            <span id="filter-button-label">Filters</span>
            <ChevronDown id="filter-chevron" size={14} class="transition-transform" />
          </button>

          <div
            id="filter-panel"
            class="hidden absolute left-0 top-16 z-20 w-[min(92vw,430px)] bg-white rounded-[2rem] border border-black/5 shadow-2xl shadow-black/10 p-6 space-y-6"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">Type</span>
                <button id="clear-filters-btn" type="button" class="text-[9px] font-black uppercase tracking-widest text-brand-primary hover:text-brand-black transition-colors">
                  Reset
                </button>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <button data-filter="All" class="filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">All</button>
                <button data-filter="public" class="filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Public</button>
                <button data-filter="official" class="filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Official</button>
                <button id="private-filter-option" data-filter="private" class="hidden filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Private</button>
              </div>
            </div>

            <div>
              <span class="block text-[9px] font-black uppercase tracking-[0.25em] text-slate-400 mb-3">Category</span>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                <button data-category-filter="All" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">All</button>
                <button data-category-filter="Social" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Social</button>
                <button data-category-filter="Academic" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Academic</button>
                <button data-category-filter="Career" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Career</button>
                <button data-category-filter="Cultural" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Cultural</button>
                <button data-category-filter="Sports" class="category-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Sports</button>
              </div>
            </div>

            <div>
              <span class="block text-[9px] font-black uppercase tracking-[0.25em] text-slate-400 mb-3">Price</span>
              <div class="grid grid-cols-3 gap-2">
                <button data-fee-filter="All" class="fee-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">All</button>
                <button data-fee-filter="free" class="fee-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Free</button>
                <button data-fee-filter="paid" class="fee-filter-button filter-option h-10 rounded-full text-[9px] font-black uppercase tracking-widest transition-all">Paid</button>
              </div>
            </div>
          </div>
        </div>

        <div id="active-filter-summary" class="hidden flex-wrap items-center gap-2"></div>

        <div class="flex-1 min-w-[280px] md:ml-auto relative group">
          <Search size={16} class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-brand-primary transition-colors" />
          <input
            id="search-input"
            type="text"
            placeholder="Search by keyword, location, or type..."
            class="w-full bg-brand-offwhite border border-transparent focus:border-brand-primary/30 focus:bg-white rounded-full py-3 pl-12 pr-6 text-sm font-light transition-all outline-none"
          />
        </div>
      </div>
    </section>

    <p id="events-status" class="text-sm text-slate-400 font-light mb-8">Loading events...</p>

    <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12"></div>
  </div>

  <script>
    import { supabase } from "../lib/supabase";

    type EventItem = {
      id: string;
      title: string;
      event_type: "public" | "private" | "official";
      category: string | null;
      event_date: string;
      event_time: string | null;
      location: string | null;
      participant_limit: number | null;
      entry_fee: number | null;
      description: string | null;
      created_by: string | null;
    };

    type RSVPItem = {
      event_id: string;
      user_id: string;
      status: "pending" | "approved" | "rejected" | "cancelled";
    };

    const grid = document.getElementById("events-grid") as HTMLDivElement;
    const status = document.getElementById("events-status") as HTMLParagraphElement;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-button");
    const categoryFilterButtons = document.querySelectorAll<HTMLButtonElement>(".category-filter-button");
    const feeFilterButtons = document.querySelectorAll<HTMLButtonElement>(".fee-filter-button");
    const filterMenu = document.getElementById("filter-menu") as HTMLDivElement;
    const filterMenuBtn = document.getElementById("filter-menu-btn") as HTMLButtonElement;
    const filterPanel = document.getElementById("filter-panel") as HTMLDivElement;
    const filterChevron = document.getElementById("filter-chevron") as HTMLElement;
    const filterButtonLabel = document.getElementById("filter-button-label") as HTMLSpanElement;
    const activeFilterSummary = document.getElementById("active-filter-summary") as HTMLDivElement;
    const clearFiltersBtn = document.getElementById("clear-filters-btn") as HTMLButtonElement;
    const privateFilterOption = document.getElementById("private-filter-option") as HTMLButtonElement;

    let events: EventItem[] = [];
    let activeFilter = "All";
    let activeCategoryFilter = "All";
    let activeFeeFilter = "All";
    let currentUserId: string | null = null;
    let goingEventIds = new Set<string>();
    let attendeeCounts = new Map<string, number>();

    function formatFilterLabel(value: string) {
      return value === "All" ? value : value.charAt(0).toUpperCase() + value.slice(1);
    }

    function escapeHtml(value: string) {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatEventType(type: string) {
      return type.charAt(0).toUpperCase() + type.slice(1);
    }

    function formatDate(dateValue: string) {
      return new Date(dateValue).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      });
    }

    function formatTime(timeValue: string | null) {
      if (!timeValue) return "";
      return ` at ${timeValue.slice(0, 5)}`;
    }

    function eventCard(event: EventItem) {
      const formattedType = formatEventType(event.event_type);
      const attendeeCount = attendeeCounts.get(event.id) ?? 0;
      const isGoing = goingEventIds.has(event.id);

      const spotsText = event.participant_limit
        ? `${attendeeCount} / ${event.participant_limit} spots filled`
        : `${attendeeCount} going`;

      const typeClasses = event.event_type === "official"
        ? "bg-brand-black text-brand-white"
        : event.event_type === "private"
          ? "bg-brand-offwhite text-brand-black border border-black/5"
          : "bg-brand-primary text-brand-black";

      const goingBadge = isGoing
        ? `<span class="text-[9px] font-black uppercase tracking-widest text-brand-primary">You’re going</span>`
        : "";

      return `
        <a
          href="/events/event_details?id=${event.id}"
          class="group block bg-white rounded-[3rem] border border-black/5 p-10 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-700 min-h-[500px]"
        >
          <div class="flex flex-col h-full">
            <div class="flex justify-between items-start mb-10">
              <span class="text-[9px] uppercase tracking-[0.2em] font-black px-4 py-2 rounded-full ${typeClasses}">
                ${formattedType}
              </span>

              <div class="text-right space-y-2">
                <span class="block text-[9px] font-black uppercase tracking-widest text-black/20 group-hover:text-brand-primary transition-colors italic">
                  ${escapeHtml(event.category ?? "General")}
                </span>
                ${goingBadge}
              </div>
            </div>

            <div class="flex-grow">
              <h3 class="text-3xl font-light text-brand-black leading-tight mb-8 group-hover:text-brand-primary transition-colors uppercase tracking-tighter italic">
                ${escapeHtml(event.title)}
              </h3>
              
              ${
                event.description
                  ? `<p class="text-slate-500 font-light text-sm leading-relaxed mb-8">${escapeHtml(event.description)}</p>`
                  : ""
              }

              <div class="space-y-5">
  <div class="flex items-center gap-4 text-xs font-black text-brand-primary uppercase tracking-widest">
    <span>•</span> ${!event.entry_fee || Number(event.entry_fee) === 0 ? "Free Access" : `${Number(event.entry_fee).toFixed(2)} CHF - Payable at Kiosk`}
  </div>

  <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
    ${escapeHtml(event.location ?? "Location TBC")}
  </div>

                <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
                  ${formatDate(event.event_date)}${formatTime(event.event_time)}
                </div>

                <div class="flex items-center gap-4 text-xs font-medium text-slate-400 uppercase tracking-widest">
                  ${spotsText}
                </div>
              </div>
            </div>

            <div class="mt-12 flex items-center justify-between py-5 px-8 rounded-2xl bg-brand-offwhite group-hover:bg-brand-black transition-all">
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-black group-hover:text-white transition-colors">
                View Event
              </span>

              <span class="text-brand-black group-hover:text-white group-hover:translate-x-2 transition-all">
                →
              </span>
            </div>
          </div>
        </a>
      `;
    }

    function updateSegmentedButtons(
      buttons: NodeListOf<HTMLButtonElement>,
      dataKey: "filter" | "categoryFilter" | "feeFilter",
      activeValue: string
    ) {
      buttons.forEach((button) => {
        const isActive = button.dataset[dataKey] === activeValue;

        button.classList.toggle("bg-brand-black", isActive);
        button.classList.toggle("text-brand-white", isActive);
        button.classList.toggle("bg-brand-offwhite", !isActive);
        button.classList.toggle("text-brand-black", !isActive);
        button.classList.toggle("hover:bg-brand-primary/20", !isActive);
      });
    }

    function updateFilterButtons() {
      updateSegmentedButtons(filterButtons, "filter", activeFilter);
      updateSegmentedButtons(categoryFilterButtons, "categoryFilter", activeCategoryFilter);
      updateSegmentedButtons(feeFilterButtons, "feeFilter", activeFeeFilter);

      const activeFilters = [
        activeFilter !== "All" ? formatFilterLabel(activeFilter) : null,
        activeCategoryFilter !== "All" ? activeCategoryFilter : null,
        activeFeeFilter !== "All" ? formatFilterLabel(activeFeeFilter) : null,
      ].filter(Boolean);

      filterButtonLabel.textContent = activeFilters.length > 0
        ? `Filters ${activeFilters.length}`
        : "Filters";

      if (activeFilters.length === 0) {
        activeFilterSummary.classList.add("hidden");
        activeFilterSummary.innerHTML = "";
        return;
      }

      activeFilterSummary.classList.remove("hidden");
      activeFilterSummary.innerHTML = activeFilters.map((filter) => `
        <span class="px-3 py-1.5 bg-brand-offwhite text-brand-black rounded-full text-[9px] font-black uppercase tracking-widest">
          ${escapeHtml(String(filter))}
        </span>
      `).join("");
    }

    function setFilterPanelOpen(isOpen: boolean) {
      filterPanel.classList.toggle("hidden", !isOpen);
      filterMenuBtn.setAttribute("aria-expanded", String(isOpen));
      filterChevron.classList.toggle("rotate-180", isOpen);
    }

    function renderEvents() {
      const searchTerm = searchInput.value.trim().toLowerCase();

      const filteredEvents = events.filter((event) => {
        const matchesFilter =
          activeFilter === "All" || event.event_type === activeFilter;

        const matchesCategory =
          activeCategoryFilter === "All" || event.category === activeCategoryFilter;

        const isFree = !event.entry_fee || Number(event.entry_fee) === 0;
        const matchesFee =
          activeFeeFilter === "All" ||
          (activeFeeFilter === "free" && isFree) ||
          (activeFeeFilter === "paid" && !isFree);

        const matchesSearch = [
          event.title,
          event.event_type,
          event.category ?? "",
          event.location ?? "",
          event.description ?? "",
        ]
          .join(" ")
          .toLowerCase()
          .includes(searchTerm);

        return matchesFilter && matchesCategory && matchesFee && matchesSearch;
      });

      if (filteredEvents.length === 0) {
        grid.innerHTML = "";
        status.textContent = "No events found yet.";
        return;
      }

      status.textContent = "";
      grid.innerHTML = filteredEvents.map(eventCard).join("");
    }

    async function loadSession() {
      const { data } = await supabase.auth.getSession();
      currentUserId = data.session?.user?.id ?? null;
    }

    async function loadEvents() {
      await loadSession();
      const today = new Date().toISOString().split("T")[0];

      const { data: rsvpData, error: rsvpError } = await supabase
        .from("event_rsvps")
        .select("event_id, user_id, status")
        .eq("status", "approved");

      if (rsvpError) {
        status.textContent = rsvpError.message;
        return;
      }

      const rsvps = (rsvpData ?? []) as RSVPItem[];

      goingEventIds = new Set(
        rsvps
          .filter((rsvp) => rsvp.user_id === currentUserId)
          .map((rsvp) => rsvp.event_id)
      );

      const { data: eventsData, error: eventsError } = await supabase
        .from("events")
        .select("id, title, event_type, category, event_date, event_time, location, participant_limit, entry_fee, description, created_by")
        .eq("approval_status", "approved")
        .gte("event_date", today)
        .order("event_date", { ascending: true });

      if (eventsError) {
        status.textContent = eventsError.message;
        return;
      }

      events = (eventsData ?? []).filter((event) => {
        return (
          event.event_type !== "private" ||
          goingEventIds.has(event.id) ||
          event.created_by === currentUserId
        );
      });

      privateFilterOption.classList.toggle(
        "hidden",
        !events.some((event) => event.event_type === "private")
      );

      attendeeCounts = new Map<string, number>();

      rsvps.forEach((rsvp) => {
        attendeeCounts.set(
          rsvp.event_id,
          (attendeeCounts.get(rsvp.event_id) ?? 0) + 1
        );
      });

      renderEvents();
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.filter ?? "All";
        updateFilterButtons();
        renderEvents();
      });
    });

    categoryFilterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategoryFilter = button.dataset.categoryFilter ?? "All";
        updateFilterButtons();
        renderEvents();
      });
    });

    feeFilterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeFeeFilter = button.dataset.feeFilter ?? "All";
        updateFilterButtons();
        renderEvents();
      });
    });

    filterMenuBtn.addEventListener("click", () => {
      setFilterPanelOpen(filterPanel.classList.contains("hidden"));
    });

    clearFiltersBtn.addEventListener("click", () => {
      activeFilter = "All";
      activeCategoryFilter = "All";
      activeFeeFilter = "All";
      updateFilterButtons();
      renderEvents();
    });

    document.addEventListener("click", (event) => {
      if (!filterMenu.contains(event.target as Node)) {
        setFilterPanelOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setFilterPanelOpen(false);
      }
    });

    searchInput.addEventListener("input", renderEvents);

    updateFilterButtons();
    loadEvents();
  </script>
</Layout>
