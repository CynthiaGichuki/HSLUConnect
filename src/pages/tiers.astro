---
import Layout from "../layouts/Layout.astro";
import { ArrowRight, BadgeCheck, Sparkles } from "lucide-astro";
import { MEMBERSHIP_TIERS } from "../lib/membership";
---

<Layout title="Membership Tiers">
  <div class="bg-white min-h-screen pt-40 pb-24">
    <div class="max-w-7xl mx-auto px-8">
      <section class="text-center mb-16">
        <div class="inline-flex items-center gap-3 bg-brand-primary/10 rounded-full px-5 py-3 mb-6">
          <Sparkles size={16} class="text-brand-primary" />
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-brand-black">
            Discover. Connect. Belong.
          </span>
        </div>

        <h1 class="text-5xl md:text-6xl font-light italic tracking-tight text-brand-black mb-5">
          Choose Your <span class="font-semibold text-brand-primary">Campus Access</span>
        </h1>
        <p class="text-slate-500 font-light text-base max-w-2xl mx-auto leading-relaxed">
          HSLUConnect membership is designed to match how often students want to explore events,
          connect with others, and belong to campus life.
        </p>
      </section>

      <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {MEMBERSHIP_TIERS.map((tier) => (
          <article
            class={`rounded-[3rem] border border-black/5 p-10 shadow-sm ${
              tier.key === "connect"
                ? "bg-brand-black text-white"
                : tier.key === "belong"
                  ? "bg-brand-offwhite"
                  : "bg-white"
            }`}
          >
            <p
              class={`text-[10px] font-black uppercase tracking-[0.3em] mb-5 ${
                tier.key === "connect" ? "text-brand-primary" : "text-slate-400"
              }`}
            >
              {tier.name}
            </p>

            <h2
              class={`text-4xl font-light italic tracking-tight mb-3 ${
                tier.key === "connect" ? "text-white" : "text-brand-black"
              }`}
            >
              {tier.priceLabel}
            </h2>

            <p
              class={`text-sm font-light leading-relaxed mb-8 ${
                tier.key === "connect" ? "text-white/70" : "text-slate-500"
              }`}
            >
              {tier.shortDescription}
            </p>

            <div class="space-y-4 mb-10">
              {tier.benefits.map((benefit) => (
                <div class="flex items-start gap-3">
                  <BadgeCheck
                    size={16}
                    class={tier.key === "connect" ? "text-brand-primary mt-0.5 shrink-0" : "text-brand-primary mt-0.5 shrink-0"}
                  />
                  <p class={tier.key === "connect" ? "text-sm text-white/80" : "text-sm text-slate-600"}>
                    {benefit}
                  </p>
                </div>
              ))}
            </div>

            <a
              href="/auth/register"
              class={`inline-flex items-center justify-center gap-3 w-full py-4 rounded-2xl text-[10px] font-black uppercase tracking-[0.3em] transition-all ${
                tier.key === "connect"
                  ? "bg-brand-primary text-brand-black hover:bg-white"
                  : "bg-brand-black text-white hover:bg-brand-primary hover:text-brand-black"
              }`}
            >
              Join {tier.name}
              <ArrowRight size={14} />
            </a>
          </article>
        ))}
      </section>

      <section class="mt-16 bg-brand-offwhite rounded-[3rem] border border-black/5 p-10 text-center">
        <p class="text-[10px] font-black uppercase tracking-[0.3em] text-brand-primary mb-4">
          Payment Flow
        </p>
        <p class="text-base text-slate-600 font-light max-w-3xl mx-auto leading-relaxed">
          For paid events, students RSVP first and receive a QR pass. At the venue, the host or an
          admin confirms payment in person, marks the attendee as paid, and then checks them in.
        </p>
      </section>
    </div>
  </div>
</Layout>
