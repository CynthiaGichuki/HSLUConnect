---
import Layout from "../layouts/Layout.astro";
import {
  Calendar,
  Users,
  ShieldCheck,
  ArrowUpRight,
  Sparkles,
} from "lucide-astro";

const featuredEvents = [
  {
    title: "Intercultural Food Festival",
    type: "Private",
    date: "April 20",
    category: "Social",
    desc: "Experience global flavors right on campus. A celebration of our diverse HSLU community.",
  },
  {
    title: "Mastering PMBOK Workshop",
    type: "Official",
    date: "April 22",
    category: "Academic",
    desc: "Deep dive into professional project management principles aligned with your MAITPRO goals.",
  },
  {
    title: "Student Networking Mixer",
    type: "Public",
    date: "April 25",
    category: "Career",
    desc: "Connect with fellow students and local partners like STAIR in a relaxed environment.",
  },
];
---

<Layout title="HSLUConnect">
  <section class="relative h-screen w-full overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 h-full w-full object-cover"
    >
      <source src="/videos/students_hanging_out.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/35 z-10"></div>

    <div
      class="relative z-20 flex h-full max-w-7xl mx-auto px-8 flex-col justify-end pb-32 items-start"
    >
      <h1
        class="text-6xl md:text-8xl font-light text-white tracking-tight mb-4"
      >
        Life at <span class="font-semibold text-brand-primary underline"
          >HSLU</span
        >
      </h1>
      <p
        class="text-xl text-white/80 max-w-md font-light leading-relaxed mb-10 tracking-wide"
      >
        Discover student-led events, cultural mixers, and official workshops.
      </p>

      <div class="flex gap-4">
        <a
          href="/explore"
          class="bg-brand-primary text-brand-black px-10 py-5 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-white transition-all shadow-2xl shadow-black/20"
        >
          Find an Event
        </a>
        <a
          href="/create"
          class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-10 py-5 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-white/20 transition-all"
        >
          Host Yours
        </a>
      </div>
    </div>
  </section>

  <section class="relative z-30 max-w-7xl mx-auto px-8 mt-24">
    <div class="flex items-center gap-4 mb-8 ml-4">
      <Sparkles size={20} class="text-brand-primary" />
      <h2
        class="text-brand-black text-[20px] font-black tracking-[0.4em] uppercase"
      >
        Featured Happenings
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        featuredEvents.map((event) => (
          /* min-h reduced from 550px to 450px for a shorter look */
          <div class="bg-white min-h-[450px] p-10 rounded-[3rem] shadow-xl flex flex-col border border-black/5 hover:-translate-y-2 transition-all duration-500 group">
            <div class="flex justify-between items-start mb-8">
              <div class="w-12 h-12 bg-brand-offwhite rounded-2xl flex items-center justify-center text-brand-primary group-hover:bg-brand-primary group-hover:text-brand-black transition-colors">
                <Calendar size={24} strokeWidth={1.5} />
              </div>
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-primary">
                {event.type}
              </span>
            </div>

            <div class="flex-grow">
              <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 italic">
                {event.category}
              </p>
              <h3 class="text-3xl font-light text-brand-black mb-4 leading-tight tracking-tighter uppercase italic group-hover:text-brand-primary transition-colors">
                {event.title}
              </h3>
              <p class="text-slate-500 font-light leading-relaxed text-sm">
                {event.desc}
              </p>
            </div>

            <div class="pt-8 mt-8 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="block text-[10px] font-bold text-slate-300 uppercase tracking-tighter">
                  Date
                </span>
                <span class="font-medium text-brand-black">{event.date}</span>
              </div>
              <a
                href="/explore"
                class="w-10 h-10 rounded-full border border-black/5 flex items-center justify-center text-brand-black hover:bg-brand-black hover:text-brand-white transition-all"
              >
                <ArrowUpRight size={18} />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div
      class="relative z-20 grid grid-cols-1 md:grid-cols-3 gap-12 text-center py-24 px-4 bg-brand-offwhite mt-24 rounded-t-[4rem]"
    >
      <div class="flex flex-col items-center">
        <span
          class="text-5xl font-black text-brand-black tracking-tighter italic"
          >500+</span
        >

        <p
          class="text-brand-primary font-black mt-2 uppercase text-[10px] tracking-[0.2em]"
        >
          Verified Students
        </p>
      </div>

      <div class="flex flex-col items-center">
        <span
          class="text-5xl font-black text-brand-black tracking-tighter italic"
          >3 Types</span
        >

        <p
          class="text-brand-primary font-black mt-2 uppercase text-[10px] tracking-[0.2em]"
        >
          Public, Private, Official
        </p>
      </div>

      <div class="flex flex-col items-center">
        <span
          class="text-5xl font-black text-brand-black tracking-tighter italic"
          >HSLU</span
        >
        <p
          class="text-brand-primary font-black mt-2 uppercase text-[10px] tracking-[0.2em]"
        >
          Exclusive Space
        </p>
      </div>
    </div>
  </section>

  <section
    class="max-w-7xl mx-auto py-40 px-8 grid grid-cols-1 md:grid-cols-2 gap-20"
  >
    <div class="flex items-start gap-8">
      <div class="p-5 bg-brand-primary/10 rounded-3xl">
        <ShieldCheck size={40} strokeWidth={1} class="text-brand-primary" />
      </div>
      <div>
        <span class="block text-3xl font-light text-brand-black mb-2"
          >Verified Community</span
        >
        <p class="text-slate-500 font-light text-sm leading-relaxed">
          Exclusively for HSLU students to ensure a safe and relevant social
          environment.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-8">
      <div class="p-5 bg-brand-primary/10 rounded-3xl">
        <Users size={40} strokeWidth={1} class="text-brand-primary" />
      </div>
      <div>
        <span class="block text-3xl font-light text-brand-black mb-2"
          >Social Inclusion</span
        >
        <p class="text-slate-500 font-light text-sm leading-relaxed">
          Promoting intercultural interaction through spontaneous and planned
          events.
        </p>
      </div>
    </div>
  </section>
</Layout>
