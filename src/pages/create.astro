---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Host Event">
  <div class="max-w-2xl mx-auto">
    <div class="glass p-10 rounded-[2rem] shadow-2xl">
      <h2 class="text-3xl font-black text-hslu-blue mb-2">Create an Event</h2>
      <p class="text-slate-500 mb-8 font-medium">Verified HSLU students only.</p>
      
      <form class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2 italic">Event Title</label>
          <input type="text" class="w-full bg-slate-50 border-none rounded-2xl p-4 focus:ring-2 focus:ring-hslu-orange transition" placeholder="e.g. End of Semester Party" />
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 italic">Event Type</label>
            <select class="w-full bg-slate-50 border-none rounded-2xl p-4">
              <option>Public</option>
              <option>Private</option>
              <option>Official</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 italic">Max Participants</label>
            <input type="number" class="w-full bg-slate-50 border-none rounded-2xl p-4" placeholder="50" />
          </div>
        </div>

        <button type="submit" class="w-full py-4 bg-hslu-orange text-white font-black text-lg rounded-2xl shadow-lg hover:shadow-orange-200 hover:-translate-y-1 transition-all">
          Publish Event
        </button>
      </form>
    </div>
  </div>
</Layout>