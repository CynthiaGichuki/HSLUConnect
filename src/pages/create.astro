---
import Layout from '../layouts/Layout.astro';
import { Sparkles, ArrowRight, Info, Calendar, MapPin, Tag } from 'lucide-astro';
---

<Layout title="Host Event">
  <div class="bg-creamy-melt min-h-screen pt-40 pb-24">
    <div class="max-w-2xl mx-auto px-6">
      
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <Sparkles size={18} class="text-brand-primary" />
          <span class="text-[10px] font-black uppercase tracking-[0.4em] text-brand-black/40">Event Management</span>
        </div>
        <h1 class="text-5xl font-light text-brand-black tracking-tighter italic mb-4">
          Host a <span class="font-semibold text-brand-primary">New Experience</span>
        </h1>
        <p class="text-slate-500 font-light leading-relaxed">
          Verified HSLU students can create and manage informal social or cultural events. 
          Please ensure your event aligns with university guidelines.
        </p>
      </header>

      <div class="bg-white/80 backdrop-blur-xl p-12 rounded-[3rem] shadow-2xl border border-white/40">
        <form id="event-form" class="space-y-8">
          
          <div class="group">
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
              Event Title
            </label>
            <input
              id="title"
              type="text"
              placeholder="e.g. End of Semester Rooftop Mixer"
              class="w-full bg-brand-offwhite border-none rounded-2xl p-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none"
              required
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
                Event Type
              </label>
              <select id="event_type" class="w-full bg-brand-offwhite border-none rounded-2xl p-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none appearance-none cursor-pointer" required>
                <option value="public">Public Event</option>
                <option value="private">Private (Invite Only)</option>
                <option value="official" id="official-option">Official Workshop</option>
              </select>
              <p id="event-type-help" class="mt-2 text-[9px] text-slate-400 flex items-center gap-1">
                <Info size={10} /> Public events are visible to all students.
              </p>
            </div>
            
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
                Category
              </label>
              <div class="relative group">
                <Tag size={16} class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-brand-primary transition-colors" />
                <select id="category" class="w-full bg-brand-offwhite border-none rounded-2xl py-5 pl-12 pr-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none appearance-none cursor-pointer" required>
                  <option value="Social">Social</option>
                  <option value="Academic">Academic</option>
                  <option value="Career">Career</option>
                  <option value="Cultural">Cultural</option>
                  <option value="Sports">Sports</option>
                </select>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
                Event Date
              </label>
              <div class="relative group">
                <Calendar size={16} class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-brand-primary transition-colors" />
                <input
                  id="event_date"
                  type="date"
                  class="w-full bg-brand-offwhite border-none rounded-2xl py-5 pl-12 pr-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none"
                  required
                />
              </div>
            </div>

            <div>
              <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
                Event Time
              </label>
              <input
                id="event_time"
                type="time"
                class="w-full bg-brand-offwhite border-none rounded-2xl p-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none"
              />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
              Participant Limit
            </label>
            <input
              id="participant_limit"
              type="number"
              min="1"
              placeholder="50"
              class="w-full bg-brand-offwhite border-none rounded-2xl p-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none"
            />
          </div>

          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
              Location
            </label>
            <div class="relative group">
              <MapPin size={16} class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-brand-primary transition-colors" />
              <input
                id="location"
                type="text"
                placeholder="e.g. Campus Zug-Rotkreuz or Online (Zoom)"
                class="w-full bg-brand-offwhite border-none rounded-2xl py-5 pl-12 pr-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none"
                required
              />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-brand-primary mb-3 ml-1 italic">
              Description
            </label>
            <textarea
              id="description"
              rows="4"
              placeholder="What makes this event special? Mention the vibe, music, or food..."
              class="w-full bg-brand-offwhite border-none rounded-2xl p-5 text-sm font-light focus:ring-2 focus:ring-brand-primary/30 transition-all outline-none resize-none"
            ></textarea>
          </div>

          <p id="message" class="hidden text-xs font-medium text-center"></p>

          <button 
            id="submit-button"
            type="submit" 
            class="group w-full py-5 bg-brand-black text-brand-white font-black uppercase text-[10px] tracking-[0.3em] rounded-2xl shadow-xl hover:bg-brand-primary hover:text-brand-black transition-all flex items-center justify-center gap-3 mt-10 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="submit-text">Publish Event</span>
            <ArrowRight size={16} class="group-hover:translate-x-1 transition-transform" />
          </button>

        </form>
      </div>

      <p class="mt-8 text-center text-[10px] text-slate-400 font-medium uppercase tracking-widest">
        By publishing, you agree to take responsibility for event safety.
      </p>

    </div>
  </div>

  <script>
    import { supabase } from "../lib/supabase";

    const form = document.getElementById("event-form") as HTMLFormElement;
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const eventTypeInput = document.getElementById("event_type") as HTMLSelectElement;
    const categoryInput = document.getElementById("category") as HTMLSelectElement;
    const eventDateInput = document.getElementById("event_date") as HTMLInputElement;
    const eventTimeInput = document.getElementById("event_time") as HTMLInputElement;
    const participantLimitInput = document.getElementById("participant_limit") as HTMLInputElement;
    const locationInput = document.getElementById("location") as HTMLInputElement;
    const descriptionInput = document.getElementById("description") as HTMLTextAreaElement;
    const message = document.getElementById("message") as HTMLParagraphElement;
    const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
    const submitText = document.getElementById("submit-text") as HTMLSpanElement;
    const officialOption = document.getElementById("official-option") as HTMLOptionElement;
    const eventTypeHelp = document.getElementById("event-type-help") as HTMLParagraphElement;

    const today = new Date().toISOString().split("T")[0];
    eventDateInput.min = today;

    let currentUserRole: string | null = null;

    function showMessage(text: string, type: "error" | "success") {
      message.textContent = text;
      message.classList.remove("hidden", "text-red-500", "text-green-600");
      message.classList.add(type === "error" ? "text-red-500" : "text-green-600");
    }

    async function loadUserRole() {
      const { data: sessionData } = await supabase.auth.getSession();
      const user = sessionData.session?.user;

      if (!user) {
        showMessage("Please log in before hosting an event.", "error");

        setTimeout(() => {
          window.location.href = "/auth/login";
        }, 1200);

        return;
      }

      const { data: profile, error } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", user.id)
        .single();

      if (error) {
        showMessage(error.message, "error");
        return;
      }

      currentUserRole = profile?.role ?? "student";

      if (currentUserRole !== "admin") {
        officialOption?.remove();

        if (eventTypeInput.value === "official") {
          eventTypeInput.value = "public";
        }

        eventTypeHelp.innerHTML = "Students can create public and private events only.";
      } else {
        eventTypeHelp.innerHTML = "Admins can create public, private, and official events.";
      }
    }

    loadUserRole();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const { data: sessionData } = await supabase.auth.getSession();
      const user = sessionData.session?.user;

      if (!user) {
        showMessage("Please log in before publishing an event.", "error");

        setTimeout(() => {
          window.location.href = "/auth/login";
        }, 1200);

        return;
      }

      const title = titleInput.value.trim();
      const event_type = eventTypeInput.value;
      const category = categoryInput.value;
      const event_date = eventDateInput.value;
      const event_time = eventTimeInput.value;
      const participant_limit = participantLimitInput.value
        ? Number(participantLimitInput.value)
        : null;
      const location = locationInput.value.trim();
      const description = descriptionInput.value.trim();

      if (!title || !event_date || !location) {
        showMessage("Please complete all required fields.", "error");
        return;
      }

      if (event_date < today) {
        showMessage("Please choose today or a future date for the event.", "error");
        return;
      }

      submitButton.disabled = true;
      submitText.textContent = "Publishing...";

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", user.id)
        .single();

      if (profileError) {
        submitButton.disabled = false;
        submitText.textContent = "Publish Event";
        showMessage(profileError.message, "error");
        return;
      }

      const role = profile?.role ?? "student";

      if (event_type === "official" && role !== "admin") {
        submitButton.disabled = false;
        submitText.textContent = "Publish Event";
        showMessage("Only admins can create official events.", "error");
        return;
      }

      const privateToken =
        event_type === "private"
          ? crypto.randomUUID()
          : null;

      const approvalStatus =
        role === "admin"
          ? "approved"
          : "pending";

      const { error } = await supabase.from("events").insert({
        title,
        description: description || null,
        event_type,
        category,
        location,
        event_date,
        event_time: event_time || null,
        participant_limit,
        created_by: user.id,
        approval_status: approvalStatus,
        approved_by: role === "admin" ? user.id : null,
        approved_at: role === "admin" ? new Date().toISOString() : null,
        private_token: privateToken,
      });

      submitButton.disabled = false;
      submitText.textContent = "Publish Event";

      if (error) {
        showMessage(error.message, "error");
        return;
      }

      showMessage(
        role === "admin"
          ? "Event published successfully."
          : "Event submitted successfully. It will go live after admin approval.",
        "success"
      );

      form.reset();

      if (role !== "admin") {
        eventTypeInput.value = "public";
      }
    });
  </script>
</Layout>