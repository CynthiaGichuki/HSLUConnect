---
import Layout from '../../layouts/Layout.astro';
import { QrCode } from 'lucide-astro';
---

<Layout title="QR Check-In">
  <div class="bg-white min-h-screen pt-40 pb-24">
    <div class="max-w-xl mx-auto px-8">
      <section class="bg-brand-offwhite rounded-[3rem] p-10 border border-black/5 text-center">
        <div id="check-icon" class="w-16 h-16 bg-brand-primary/20 rounded-full mx-auto mb-6 flex items-center justify-center text-brand-primary">
          <QrCode size={34} strokeWidth={1.5} />
        </div>

        <h1 class="text-4xl font-light text-brand-black tracking-tighter italic mb-3">
          QR <span class="font-semibold text-brand-primary">Check-In</span>
        </h1>

        <p id="check-status" class="text-sm text-slate-500 font-light mb-8">
          Validating QR code...
        </p>

        <div id="check-card" class="hidden bg-white rounded-[2rem] p-6 border border-black/5 text-left mb-6">
          <p class="text-[10px] font-black uppercase tracking-widest text-brand-primary mb-2">Attendee</p>
          <p id="attendee-name" class="text-xl font-light italic text-brand-black"></p>
          <p id="attendee-email" class="text-xs text-slate-400 mt-1"></p>
          <p id="attendee-tier" class="text-[10px] font-black uppercase tracking-widest text-slate-300 mt-3"></p>

          <div class="border-t border-black/5 mt-6 pt-6">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-primary mb-2">Event</p>
            <p id="event-title" class="text-sm font-bold text-brand-black"></p>
            <p id="event-date" class="text-xs text-slate-400 mt-1"></p>
          </div>

          <div class="border-t border-black/5 mt-6 pt-6">
            <p class="text-[10px] font-black uppercase tracking-widest text-brand-primary mb-2">Payment</p>
            <p id="payment-status" class="text-sm font-bold text-brand-black"></p>
            <p id="payment-note" class="text-xs text-slate-400 mt-1"></p>
          </div>
        </div>

        <button
          id="mark-paid-btn"
          class="hidden w-full py-4 bg-green-50 text-green-700 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-green-100 transition-all disabled:opacity-60 disabled:cursor-not-allowed mb-3"
        >
          Mark as Paid
        </button>

        <button
          id="check-in-btn"
          class="hidden w-full py-4 bg-brand-black text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-primary hover:text-brand-black transition-all disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Confirm Check-In
        </button>

        <a
          href="/explore"
          class="inline-flex mt-6 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-brand-primary transition-all"
        >
          Back to Events
        </a>
      </section>
    </div>
  </div>

  <script>
    import { supabase } from "../../lib/supabase";
    import {
      formatMembershipTierLabel,
      getPayableAmount,
      normalizeMembershipTier,
    } from "../../lib/membership";

    type CheckInRow = {
      event_id: string;
      user_id: string;
      status: "pending" | "approved" | "rejected" | "cancelled";
      payment_status?: "not_required" | "unpaid" | "paid" | null;
      paid_at?: string | null;
      paid_amount?: number | null;
      checked_in?: boolean | null;
      checked_in_at?: string | null;
      events:
        | {
            id: string;
            title: string;
            event_date: string;
            event_time: string | null;
            created_by: string;
            entry_fee?: number | null;
          }
        | {
            id: string;
            title: string;
            event_date: string;
            event_time: string | null;
            created_by: string;
            entry_fee?: number | null;
          }[]
        | null;
      profiles:
        | {
            full_name: string | null;
            email: string | null;
            membership_tier?: string | null;
          }
        | {
            full_name: string | null;
            email: string | null;
            membership_tier?: string | null;
          }[]
        | null;
    };

    const params = new URLSearchParams(window.location.search);
    const token = params.get("token");

    const checkStatus = document.getElementById("check-status") as HTMLParagraphElement;
    const checkCard = document.getElementById("check-card") as HTMLDivElement;
    const checkInBtn = document.getElementById("check-in-btn") as HTMLButtonElement;
    const markPaidBtn = document.getElementById("mark-paid-btn") as HTMLButtonElement;
    const attendeeName = document.getElementById("attendee-name") as HTMLParagraphElement;
    const attendeeEmail = document.getElementById("attendee-email") as HTMLParagraphElement;
    const attendeeTier = document.getElementById("attendee-tier") as HTMLParagraphElement;
    const eventTitle = document.getElementById("event-title") as HTMLParagraphElement;
    const eventDate = document.getElementById("event-date") as HTMLParagraphElement;
    const paymentStatus = document.getElementById("payment-status") as HTMLParagraphElement;
    const paymentNote = document.getElementById("payment-note") as HTMLParagraphElement;
    const checkIcon = document.getElementById("check-icon") as HTMLDivElement;

    let checkInRow: CheckInRow | null = null;

    function getSingle<T>(value: T | T[] | null) {
      return Array.isArray(value) ? value[0] : value;
    }

    function formatDate(dateValue: string, timeValue: string | null) {
      const date = new Date(dateValue).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      });

      return timeValue ? `${date} at ${timeValue.slice(0, 5)}` : date;
    }

    function formatCurrency(amount: number) {
      return `${amount.toFixed(2)} CHF`;
    }

    function getEffectivePaymentStatus() {
      if (!checkInRow) return "not_required";

      return checkInRow.payment_status ?? (Number(getSingle(checkInRow.events)?.entry_fee ?? 0) > 0 ? "unpaid" : "not_required");
    }

    function renderPaymentState() {
      if (!checkInRow) return;

      const event = getSingle(checkInRow.events);
      const attendee = getSingle(checkInRow.profiles);
      const tier = normalizeMembershipTier(attendee?.membership_tier);
      const amountDue = getPayableAmount(event?.entry_fee, tier);
      const effectivePaymentStatus = getEffectivePaymentStatus();

      attendeeTier.textContent = `${formatMembershipTierLabel(tier)} member`;

      if (effectivePaymentStatus === "paid") {
        paymentStatus.textContent = `Paid${checkInRow.paid_amount ? ` • ${formatCurrency(Number(checkInRow.paid_amount))}` : ""}`;
        paymentNote.textContent = checkInRow.paid_at
          ? `Confirmed on ${new Date(checkInRow.paid_at).toLocaleString("en-US", {
              month: "short",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            })}`
          : "Payment has been confirmed.";
      } else if (effectivePaymentStatus === "unpaid") {
        paymentStatus.textContent = `Unpaid • ${formatCurrency(amountDue)} due`;
        paymentNote.textContent = "Confirm cash or TWINT in person before check-in.";
      } else {
        paymentStatus.textContent = "Free Access";
        paymentNote.textContent = "No payment is required for this attendee.";
      }

      markPaidBtn.classList.toggle("hidden", effectivePaymentStatus !== "unpaid");
      checkInBtn.classList.remove("hidden");
      checkInBtn.disabled = effectivePaymentStatus === "unpaid" || checkInRow.checked_in === true;
      checkInBtn.textContent = checkInRow.checked_in ? "Already Checked In" : "Confirm Check-In";
    }

    function setFailure(text: string) {
      checkStatus.textContent = text;
      checkStatus.classList.remove("text-slate-500", "text-green-600");
      checkStatus.classList.add("text-red-500");
      checkIcon.className = "w-16 h-16 bg-red-50 rounded-full mx-auto mb-6 flex items-center justify-center text-red-500";
      checkIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>';
    }

    function setSuccess(text: string) {
      checkStatus.textContent = text;
      checkStatus.classList.remove("text-slate-500", "text-red-500");
      checkStatus.classList.add("text-green-600");
      checkIcon.className = "w-16 h-16 bg-green-50 rounded-full mx-auto mb-6 flex items-center justify-center text-green-600";
      checkIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.8 10A10 10 0 1 1 17 3.3"/><path d="m9 11 3 3L22 4"/></svg>';
    }

    async function loadCheckIn() {
      if (!token) {
        setFailure("Missing QR token.");
        return;
      }

      const { data: sessionData } = await supabase.auth.getSession();
      const currentUser = sessionData.session?.user;

      if (!currentUser) {
        window.location.href = `/auth/login?redirect=${encodeURIComponent(window.location.pathname + window.location.search)}`;
        return;
      }

      const { data: profile } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", currentUser.id)
        .single();

      const { data, error } = await supabase
        .from("event_rsvps")
        .select(`
          event_id,
          user_id,
          status,
          payment_status,
          paid_at,
          paid_amount,
          checked_in,
          checked_in_at,
          events:event_id (
            id,
            title,
            event_date,
            event_time,
            created_by,
            entry_fee
          ),
          profiles:user_id (
            *
          )
        `)
        .eq("qr_token", token)
        .single();

      if (error || !data) {
        setFailure(error?.message || "QR code not found.");
        return;
      }

      checkInRow = data as CheckInRow;
      const event = getSingle(checkInRow.events);
      const attendee = getSingle(checkInRow.profiles);

      if (!event) {
        setFailure("Event not found for this QR code.");
        return;
      }

      const canManage = event.created_by === currentUser.id || profile?.role === "admin";
      if (!canManage) {
        setFailure("Only the event creator or an admin can check in this attendee.");
        return;
      }

      if (checkInRow.status !== "approved") {
        setFailure("This QR code is not attached to an approved RSVP.");
        return;
      }

      attendeeName.textContent = attendee?.full_name || "HSLU Student";
      attendeeEmail.textContent = attendee?.email || "Email unavailable";
      eventTitle.textContent = event.title;
      eventDate.textContent = formatDate(event.event_date, event.event_time);

      checkCard.classList.remove("hidden");
      renderPaymentState();
      setSuccess("QR code is valid.");
    }

    markPaidBtn.addEventListener("click", async () => {
      if (!checkInRow || !token) return;

      const event = getSingle(checkInRow.events);
      const attendee = getSingle(checkInRow.profiles);
      const amountDue = getPayableAmount(event?.entry_fee, attendee?.membership_tier);

      const { data: sessionData } = await supabase.auth.getSession();
      const currentUserId = sessionData.session?.user.id;

      markPaidBtn.disabled = true;
      markPaidBtn.textContent = "Saving...";

      const { error } = await supabase
        .from("event_rsvps")
        .update({
          payment_status: "paid",
          paid_at: new Date().toISOString(),
          paid_amount: amountDue,
          payment_confirmed_by: currentUserId,
        })
        .eq("qr_token", token)
        .eq("status", "approved");

      if (error) {
        markPaidBtn.disabled = false;
        markPaidBtn.textContent = "Mark as Paid";
        setFailure(`${error.message} If payment columns are missing, run the membership and payments migration.`);
        return;
      }

      checkInRow = {
        ...checkInRow,
        payment_status: "paid",
        paid_at: new Date().toISOString(),
        paid_amount: amountDue,
      };

      markPaidBtn.disabled = false;
      markPaidBtn.textContent = "Mark as Paid";
      renderPaymentState();
      setSuccess("Payment confirmed. You can now check in the attendee.");
    });

    checkInBtn.addEventListener("click", async () => {
      if (!checkInRow || !token) return;

      checkInBtn.disabled = true;
      checkInBtn.textContent = "Checking in...";

      const { error } = await supabase
        .from("event_rsvps")
        .update({
          checked_in: true,
          checked_in_at: new Date().toISOString(),
        })
        .eq("qr_token", token)
        .eq("status", "approved");

      if (error) {
        checkInBtn.disabled = false;
        checkInBtn.textContent = "Confirm Check-In";
        setFailure(`${error.message} If the database does not have checked_in_at yet, add that column to event_rsvps.`);
        return;
      }

      checkInRow = {
        ...checkInRow,
        checked_in: true,
        checked_in_at: new Date().toISOString(),
      };

      renderPaymentState();
      setSuccess("Attendee checked in successfully.");
    });

    loadCheckIn();
  </script>
</Layout>
