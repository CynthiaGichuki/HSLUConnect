---
import Layout from '../../layouts/Layout.astro';
import { Calendar, MapPin, Users, ArrowLeft, Edit, Trash2, User } from 'lucide-astro';
---

<Layout title="Event Details">
  <div class="bg-white min-h-screen pt-40 pb-24">
    <div class="max-w-5xl mx-auto px-8">

      <a href="/explore" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-brand-primary transition-all mb-10">
        <ArrowLeft size={14} /> Back to Events
      </a>

      <p id="status" class="text-sm text-slate-400 mb-8">Loading event...</p>

      <section id="event-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-10">
        <main class="lg:col-span-8 bg-brand-offwhite rounded-[3rem] p-10 border border-black/5">
          <div class="flex flex-wrap gap-3 mb-8">
            <span id="event-type" class="text-[9px] uppercase tracking-[0.2em] font-black px-4 py-2 rounded-full bg-brand-primary text-brand-black"></span>
            <span id="event-category" class="text-[9px] uppercase tracking-[0.2em] font-black px-4 py-2 rounded-full bg-white text-slate-400"></span>
            <span id="approval-status-badge" class="hidden text-[9px] uppercase tracking-[0.2em] font-black px-4 py-2 rounded-full"></span>
          </div>

          <h1 id="event-title" class="text-5xl font-light italic tracking-tight text-brand-black mb-6"></h1>

          <a
            id="creator-profile-link"
            href="#"
            class="inline-flex items-center gap-3 bg-white rounded-full py-2 pl-2 pr-5 border border-black/5 hover:bg-brand-black hover:text-white transition-all mb-8 group"
          >
            <span class="w-9 h-9 rounded-full bg-brand-primary/20 text-brand-primary flex items-center justify-center group-hover:bg-white/10">
              <User size={16} />
            </span>
            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 group-hover:text-white/60">
              Hosted by
            </span>
            <span id="creator-name" class="text-sm font-bold text-brand-black group-hover:text-white">
              Loading...
            </span>
          </a>

          <p id="event-description" class="text-slate-500 font-light leading-relaxed mb-10"></p>

          <div class="space-y-5">
            <div class="flex items-center gap-4 text-sm text-slate-500">
              <Calendar size={18} class="text-brand-primary" />
              <span id="event-date"></span>
            </div>

            <div class="flex items-center gap-4 text-sm text-slate-500">
              <MapPin size={18} class="text-brand-primary" />
              <span id="event-location"></span>
            </div>

            <div class="flex items-center gap-4 text-sm text-slate-500">
              <Users size={18} class="text-brand-primary" />
              <span id="event-spots"></span>
            </div>

            <div class="flex items-center gap-4 text-sm text-slate-500">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-coins text-brand-primary"><circle cx="8" cy="8" r="6"/><circle cx="18" cy="18" r="4"/><path d="M12 18a6 6 0 0 0-6-6"/><path d="M14.3 4.3A6 6 0 0 1 19.7 9.7"/></svg>
  <span id="event-fee"></span>
</div>
          </div>
        </main>

        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-white rounded-[3rem] p-8 border border-black/5 shadow-sm">
            <h2 class="text-xl font-light italic text-brand-black mb-6">Event <span class="font-semibold text-brand-primary">Action</span></h2>

            <button id="rsvp-btn" class="w-full py-4 bg-brand-black text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-primary hover:text-brand-black transition-all disabled:opacity-60 disabled:cursor-not-allowed">
              Loading...
            </button>

            <p id="action-message" class="hidden mt-4 text-xs font-medium"></p>
          </div>

          <div id="qr-pass-panel" class="hidden bg-brand-offwhite rounded-[3rem] p-8 border border-black/5 text-center">
            <h2 class="text-xl font-light italic text-brand-black mb-3">
              Entry <span class="font-semibold text-brand-primary">QR</span>
            </h2>
            <p class="text-xs text-slate-500 font-light mb-6">
              Show this code at check-in.
            </p>
            <img
              id="qr-pass-image"
              alt="Event check-in QR code"
              class="w-48 h-48 mx-auto rounded-2xl bg-white p-3 border border-black/5"
            />
            <a
              id="qr-pass-link"
              href="#"
              class="mt-6 inline-flex justify-center w-full py-3 bg-white text-brand-black rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-black hover:text-white transition-all"
            >
              Open Check-In Code
            </a>
          </div>

          <div id="creator-panel" class="hidden bg-brand-offwhite rounded-[3rem] p-8 border border-black/5">
            <h2 class="text-xl font-light italic text-brand-black mb-6">Creator <span class="font-semibold text-brand-primary">Tools</span></h2>

            <button id="copy-private-link-btn" class="hidden w-full py-4 bg-white text-brand-black rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-primary transition-all mb-4">
              Copy Private Invite Link
            </button>

            <button id="toggle-edit-btn" class="w-full py-4 bg-white text-brand-black rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-black hover:text-white transition-all flex items-center justify-center gap-2 mb-4">
              <Edit size={14} /> Edit Event
            </button>

            <button id="delete-event-btn" class="w-full py-4 bg-red-50 text-red-500 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-red-500 hover:text-white transition-all flex items-center justify-center gap-2">
              <Trash2 size={14} /> Delete Event
            </button>
          </div>

          <div id="attendees-panel" class="hidden bg-white rounded-[3rem] p-8 border border-black/5">
            <div class="flex items-center justify-between gap-4 mb-6">
              <h2 class="text-xl font-light italic text-brand-black">
                RSVP <span class="font-semibold text-brand-primary">List</span>
              </h2>

              <button
                id="copy-all-emails-btn"
                class="hidden text-[9px] font-black uppercase tracking-widest bg-brand-offwhite text-brand-black px-4 py-2 rounded-full hover:bg-brand-black hover:text-white transition-all"
              >
                Copy All
              </button>
            </div>

            <p id="copy-message" class="hidden text-xs font-medium mb-4"></p>

            <div id="attendees-list" class="space-y-4"></div>
          </div>
        </aside>
      </section>

      <section id="edit-form-wrapper" class="hidden mt-12 bg-white rounded-[3rem] p-10 border border-black/5">
        <h2 class="text-3xl font-light italic text-brand-black mb-8">Edit <span class="font-semibold text-brand-primary">Event</span></h2>

        <form id="edit-event-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <input id="edit-title" type="text" placeholder="Event title" class="md:col-span-2 bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" required />

          <select id="edit-event-type" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none">
            <option value="public">Public</option>
            <option value="private">Private</option>
            <option value="official">Official</option>
          </select>

          <input id="edit-category" type="text" placeholder="Category" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" />

          <input id="edit-date" type="date" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" required />

          <input id="edit-time" type="time" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" />

          <input id="edit-location" type="text" placeholder="Location" class="md:col-span-2 bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" required />

         <input id="edit-limit" type="number" min="1" placeholder="Participant limit" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" />
<input id="edit-fee" type="number" min="0" step="0.50" placeholder="Entry Fee (CHF - Payable at Kiosk)" class="bg-brand-offwhite rounded-2xl p-4 text-sm outline-none" />

          <textarea id="edit-description" rows="4" placeholder="Description" class="md:col-span-2 bg-brand-offwhite rounded-2xl p-4 text-sm outline-none resize-none"></textarea>

          <button id="save-event-btn" type="submit" class="md:col-span-2 py-4 bg-brand-black text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-primary hover:text-brand-black transition-all">
            Save Changes
          </button>
        </form>
      </section>

    </div>
  </div>

  <script>
    import { supabase } from "../../lib/supabase";

    const params = new URLSearchParams(window.location.search);
    const eventId = params.get("id");
    const privateToken = params.get("token");

    type RsvpRow = {
      user_id: string;
      status: "pending" | "approved" | "rejected" | "cancelled";
      qr_token: string | null;
      profiles:
        | {
            full_name: string | null;
            email: string | null;
          }
        | {
            full_name: string | null;
            email: string | null;
          }[]
        | null;
    };

    type CreatorProfile = {
      full_name: string | null;
      email: string | null;
    };

    let currentUserId: string | null = null;
    let currentUserRole: string | null = null;
    let currentEvent: any = null;
    let isGoing = false;
    let currentUserRsvpStatus: string | undefined = undefined;
    let attendeeEmails: string[] = [];
    let allRsvps: RsvpRow[] = [];
    let approvedRsvpCount = 0;

    const status = document.getElementById("status") as HTMLParagraphElement;
    const eventContent = document.getElementById("event-content") as HTMLElement;
    const actionMessage = document.getElementById("action-message") as HTMLParagraphElement;

    const eventTitle = document.getElementById("event-title") as HTMLHeadingElement;
    const eventDescription = document.getElementById("event-description") as HTMLParagraphElement;
    const eventType = document.getElementById("event-type") as HTMLSpanElement;
    const eventCategory = document.getElementById("event-category") as HTMLSpanElement;
    const approvalStatusBadge = document.getElementById("approval-status-badge") as HTMLSpanElement;
    const eventDate = document.getElementById("event-date") as HTMLSpanElement;
    const eventLocation = document.getElementById("event-location") as HTMLSpanElement;
    const eventSpots = document.getElementById("event-spots") as HTMLSpanElement;
    const eventFee = document.getElementById("event-fee") as HTMLSpanElement;
    const creatorProfileLink = document.getElementById("creator-profile-link") as HTMLAnchorElement;
    const creatorName = document.getElementById("creator-name") as HTMLSpanElement;

    const rsvpBtn = document.getElementById("rsvp-btn") as HTMLButtonElement;
    const qrPassPanel = document.getElementById("qr-pass-panel") as HTMLDivElement;
    const qrPassImage = document.getElementById("qr-pass-image") as HTMLImageElement;
    const qrPassLink = document.getElementById("qr-pass-link") as HTMLAnchorElement;
    const creatorPanel = document.getElementById("creator-panel") as HTMLDivElement;
    const attendeesPanel = document.getElementById("attendees-panel") as HTMLDivElement;
    const attendeesList = document.getElementById("attendees-list") as HTMLDivElement;

    const toggleEditBtn = document.getElementById("toggle-edit-btn") as HTMLButtonElement;
    const deleteEventBtn = document.getElementById("delete-event-btn") as HTMLButtonElement;
    const editFormWrapper = document.getElementById("edit-form-wrapper") as HTMLDivElement;
    const editEventForm = document.getElementById("edit-event-form") as HTMLFormElement;
    const saveEventBtn = document.getElementById("save-event-btn") as HTMLButtonElement;

    const editTitle = document.getElementById("edit-title") as HTMLInputElement;
    const editEventType = document.getElementById("edit-event-type") as HTMLSelectElement;
    const editCategory = document.getElementById("edit-category") as HTMLInputElement;
    const editDate = document.getElementById("edit-date") as HTMLInputElement;
    const editTime = document.getElementById("edit-time") as HTMLInputElement;
    const editLocation = document.getElementById("edit-location") as HTMLInputElement;
    const editLimit = document.getElementById("edit-limit") as HTMLInputElement;
    const editFee = document.getElementById("edit-fee") as HTMLInputElement;
    const editDescription = document.getElementById("edit-description") as HTMLTextAreaElement;

    const copyAllEmailsBtn = document.getElementById("copy-all-emails-btn") as HTMLButtonElement;
    const copyMessage = document.getElementById("copy-message") as HTMLParagraphElement;
    const copyPrivateLinkBtn = document.getElementById("copy-private-link-btn") as HTMLButtonElement;

    function escapeHtml(value: string) {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function showActionMessage(text: string, type: "error" | "success") {
      actionMessage.textContent = text;
      actionMessage.classList.remove("hidden", "text-red-500", "text-green-600");
      actionMessage.classList.add(type === "error" ? "text-red-500" : "text-green-600");
    }

    function showCopyMessage(text: string, type: "error" | "success") {
      copyMessage.textContent = text;
      copyMessage.classList.remove("hidden", "text-red-500", "text-green-600");
      copyMessage.classList.add(type === "error" ? "text-red-500" : "text-green-600");
    }

    function formatDate(dateValue: string) {
      return new Date(dateValue).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      });
    }

    function formatTime(timeValue: string | null) {
      if (!timeValue) return "";
      return ` at ${timeValue.slice(0, 5)}`;
    }

    function formatStatusLabel(value: string) {
      return value.charAt(0).toUpperCase() + value.slice(1);
    }

    function getRsvpProfile(rsvp: RsvpRow) {
      return Array.isArray(rsvp.profiles)
        ? rsvp.profiles[0]
        : rsvp.profiles;
    }

    function hasAvailableApprovedSlot(ignoreUserId?: string) {
      const limit = currentEvent?.participant_limit;
      if (!limit) return true;

      const approvedCount = allRsvps.filter((rsvp) => {
        return rsvp.status === "approved" && rsvp.user_id !== ignoreUserId;
      }).length;

      return approvedCount < Number(limit);
    }

    function isEventFullForCurrentUser() {
      if (!currentEvent?.participant_limit) return false;
      if (currentUserRsvpStatus === "approved") return false;

      return approvedRsvpCount >= Number(currentEvent.participant_limit);
    }

    function renderQrPass() {
      qrPassPanel.classList.add("hidden");

      const currentUserRsvp = allRsvps.find((rsvp) => rsvp.user_id === currentUserId);
      if (!currentUserRsvp?.qr_token || currentUserRsvp.status !== "approved") return;

      const checkInUrl = `${window.location.origin}/events/check_in?token=${encodeURIComponent(currentUserRsvp.qr_token)}`;
      qrPassImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(checkInUrl)}`;
      qrPassLink.href = checkInUrl;
      qrPassPanel.classList.remove("hidden");
    }

    async function loadSession() {
      const { data } = await supabase.auth.getSession();
      currentUserId = data.session?.user?.id ?? null;

      if (!currentUserId) {
        currentUserRole = null;
        return;
      }

      const { data: profile } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", currentUserId)
        .single();

      currentUserRole = profile?.role ?? "student";
    }

    function renderApprovalBadge(event: any, canManage: boolean) {
      approvalStatusBadge.classList.add("hidden");

      if (!canManage) return;

      approvalStatusBadge.textContent = `Event ${formatStatusLabel(event.approval_status ?? "pending")}`;
      approvalStatusBadge.classList.remove(
        "hidden",
        "bg-yellow-50",
        "text-yellow-700",
        "bg-green-50",
        "text-green-700",
        "bg-red-50",
        "text-red-600"
      );

      if (event.approval_status === "approved") {
        approvalStatusBadge.classList.add("bg-green-50", "text-green-700");
      } else if (event.approval_status === "rejected") {
        approvalStatusBadge.classList.add("bg-red-50", "text-red-600");
      } else {
        approvalStatusBadge.classList.add("bg-yellow-50", "text-yellow-700");
      }
    }

    function renderRsvpButton() {
      if (!currentUserId) {
        rsvpBtn.textContent = "Login to RSVP";
        rsvpBtn.disabled = false;
        return;
      }

      if (currentEvent?.created_by === currentUserId) {
        rsvpBtn.textContent = "You created this event";
        rsvpBtn.disabled = true;
        return;
      }

      if (currentUserRsvpStatus === "pending") {
        rsvpBtn.textContent = "Cancel Pending RSVP";
        rsvpBtn.disabled = false;
        return;
      }

      if (currentUserRsvpStatus === "approved") {
        rsvpBtn.textContent = "Cancel RSVP";
        rsvpBtn.disabled = false;
        return;
      }

      if (currentUserRsvpStatus === "rejected") {
        rsvpBtn.textContent = "RSVP Rejected";
        rsvpBtn.disabled = true;
        return;
      }

      if (isEventFullForCurrentUser()) {
        rsvpBtn.textContent = "Event Full";
        rsvpBtn.disabled = true;
        return;
      }

      rsvpBtn.textContent = "RSVP Now";
      rsvpBtn.disabled = false;
    }

    async function loadEvent() {
      if (!eventId) {
        status.textContent = "Event not found.";
        return;
      }

      await loadSession();

      const { data: event, error } = await supabase
        .from("events")
        .select("id, title, description, event_type, category, event_date, event_time, location, participant_limit, entry_fee, created_by, approval_status, private_token, rejected_reason")        .eq("id", eventId)
        .single();

      if (error || !event) {
        status.textContent = error?.message || "Event not found.";
        return;
      }

      currentEvent = event;

      const { data: creatorProfile } = await supabase
        .from("profiles")
        .select("full_name, email")
        .eq("id", event.created_by)
        .maybeSingle();

      const creator = creatorProfile as CreatorProfile | null;
      creatorName.textContent = creator?.full_name || creator?.email || "HSLU Student";
      creatorProfileLink.href = `/users/profile?id=${encodeURIComponent(event.created_by)}`;

      const isCreator = currentUserId === event.created_by;
      const isAdmin = currentUserRole === "admin";
      const canViewRestrictedEvent = isCreator || isAdmin;
      const canManageEvent = isCreator;
      const hasPrivateToken = Boolean(event.private_token && privateToken === event.private_token);

      if (event.approval_status !== "approved" && !canViewRestrictedEvent) {
        status.textContent = "This event is still awaiting admin approval.";
        return;
      }

      if (event.event_type === "private" && !canViewRestrictedEvent && !hasPrivateToken) {
        status.textContent = "This private event can only be viewed with an invite link.";
        return;
      }

      const { data: rsvps, error: rsvpError } = await supabase
        .from("event_rsvps")
        .select(`
          user_id,
          status,
          qr_token,
          profiles:user_id (
            full_name,
            email
          )
        `)
        .eq("event_id", eventId);

      if (rsvpError) {
        status.textContent = rsvpError.message;
        return;
      }

      allRsvps = (rsvps ?? []) as RsvpRow[];
      const approvedRsvps = allRsvps.filter((rsvp) => rsvp.status === "approved");
      const activeRsvps = allRsvps.filter((rsvp) =>
        ["pending", "approved", "rejected"].includes(rsvp.status)
      );
      const attendeeCount = approvedRsvps.length;
      approvedRsvpCount = attendeeCount;

      const currentUserRsvp = allRsvps.find((rsvp) => rsvp.user_id === currentUserId);
      currentUserRsvpStatus = currentUserRsvp?.status;

      isGoing =
        currentUserRsvpStatus === "approved" ||
        currentUserRsvpStatus === "pending";

      eventTitle.textContent = event.title;
      eventDescription.textContent = event.description || "No description added yet.";
      eventType.textContent = event.event_type;
      eventCategory.textContent = event.category || "General";

      if (currentUserId === event.created_by || currentUserRole === "admin") {
        status.textContent =
          event.approval_status === "pending"
            ? "This event is awaiting admin approval."
            : event.approval_status === "rejected"
              ? `This event was rejected. ${event.rejected_reason ?? ""}`
              : "";
      }

      const canSeePrivateDetails =
        canViewRestrictedEvent ||
        event.event_type !== "private" ||
        currentUserRsvpStatus === "approved";

      eventDate.textContent = canSeePrivateDetails
        ? `${formatDate(event.event_date)}${formatTime(event.event_time)}`
        : "Date visible after RSVP approval";

      eventLocation.textContent = canSeePrivateDetails
        ? event.location || "Location TBC"
        : "Location visible after RSVP approval";

      eventSpots.textContent = event.participant_limit
        ? `${attendeeCount} / ${event.participant_limit} spots filled`
        : `${attendeeCount} approved RSVP${attendeeCount === 1 ? "" : "s"}`;

      eventFee.textContent = !event.entry_fee || Number(event.entry_fee) === 0
  ? "Free Access"
  : `${Number(event.entry_fee).toFixed(2)} CHF`;

      renderApprovalBadge(event, canViewRestrictedEvent);
      renderRsvpButton();
      renderQrPass();

      if (canManageEvent) {
        creatorPanel.classList.remove("hidden");
        attendeesPanel.classList.remove("hidden");
        renderAttendees(activeRsvps, canManageEvent);
      } else {
        creatorPanel.classList.add("hidden");
        attendeesPanel.classList.add("hidden");
      }

      if (event.event_type === "private" && isCreator) {
        copyPrivateLinkBtn.classList.remove("hidden");
      } else {
        copyPrivateLinkBtn.classList.add("hidden");
      }

      fillEditForm();

      status.textContent =
        canViewRestrictedEvent && event.approval_status === "pending"
          ? "This event is awaiting admin approval."
          : canViewRestrictedEvent && event.approval_status === "rejected"
            ? `This event was rejected. ${event.rejected_reason ?? ""}`
            : "";

      eventContent.classList.remove("hidden");
    }

    function fillEditForm() {
      if (!currentEvent) return;

      editTitle.value = currentEvent.title ?? "";
      editEventType.value = currentEvent.event_type ?? "public";
      editCategory.value = currentEvent.category ?? "";
      editDate.value = currentEvent.event_date ?? "";
      editTime.value = currentEvent.event_time?.slice(0, 5) ?? "";
      editLocation.value = currentEvent.location ?? "";
      editLimit.value = currentEvent.participant_limit ?? "";
      editFee.value = currentEvent.entry_fee ?? "0";
      editDescription.value = currentEvent.description ?? "";

      if (currentUserRole !== "admin") {
        const officialOption = editEventType.querySelector('option[value="official"]');
        officialOption?.remove();
      }
    }

    function renderAttendees(rsvps: RsvpRow[], canManage: boolean) {
      attendeeEmails = rsvps
        .filter((rsvp) => rsvp.status === "approved")
        .map((rsvp) => getRsvpProfile(rsvp)?.email ?? "")
        .filter(Boolean);

      if (rsvps.length === 0) {
        copyAllEmailsBtn.classList.add("hidden");
        attendeesList.innerHTML = `<p class="text-xs text-slate-400">No RSVPs yet.</p>`;
        return;
      }

      if (attendeeEmails.length > 0) {
        copyAllEmailsBtn.classList.remove("hidden");
      } else {
        copyAllEmailsBtn.classList.add("hidden");
      }

      attendeesList.innerHTML = rsvps.map((rsvp) => {
        const name = escapeHtml(getRsvpProfile(rsvp)?.full_name ?? "HSLU Student");
        const email = escapeHtml(getRsvpProfile(rsvp)?.email ?? "Email unavailable");

        const statusClass =
          rsvp.status === "approved"
            ? "bg-green-50 text-green-700"
            : rsvp.status === "pending"
              ? "bg-yellow-50 text-yellow-700"
              : rsvp.status === "rejected"
                ? "bg-red-50 text-red-600"
                : "bg-slate-100 text-slate-500";

        const approvalButtons =
          canManage && rsvp.status === "pending"
            ? `
              <div class="flex gap-2 mt-3">
                <button data-user-id="${rsvp.user_id}" class="approve-rsvp-btn text-[9px] font-black uppercase bg-green-50 text-green-600 px-3 py-2 rounded-full hover:bg-green-100 transition-all">
                  Approve
                </button>
                <button data-user-id="${rsvp.user_id}" class="reject-rsvp-btn text-[9px] font-black uppercase bg-red-50 text-red-500 px-3 py-2 rounded-full hover:bg-red-100 transition-all">
                  Reject
                </button>
              </div>
            `
            : "";

        const copyButton =
          rsvp.status === "approved"
            ? `
              <button
                type="button"
                data-email="${email}"
                class="copy-email-btn shrink-0 text-[9px] font-black uppercase tracking-widest bg-brand-offwhite text-brand-black px-3 py-2 rounded-full hover:bg-brand-primary transition-all"
              >
                Copy
              </button>
            `
            : "";

        return `
          <div class="text-xs text-slate-500 border-b border-black/5 pb-4">
            <div class="flex items-center justify-between gap-4">
              <div class="min-w-0">
                <p class="font-bold text-brand-black truncate">${name}</p>
                <p class="text-slate-400 truncate">${email}</p>
                <span class="inline-block mt-2 text-[9px] font-black uppercase tracking-widest px-3 py-1 rounded-full ${statusClass}">
                  ${formatStatusLabel(rsvp.status)}
                </span>
              </div>

              ${copyButton}
            </div>

            ${approvalButtons}
          </div>
        `;
      }).join("");

      attachCopyEmailListeners();
      attachRsvpApprovalListeners();
    }

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        showCopyMessage("Copied to clipboard.", "success");
      } catch {
        showCopyMessage("Could not copy. Please copy manually.", "error");
      }
    }

    function attachCopyEmailListeners() {
      document.querySelectorAll<HTMLButtonElement>(".copy-email-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const email = button.dataset.email;

          if (!email || email === "Email unavailable") return;

          await copyText(email);

          button.textContent = "Copied";
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1200);
        });
      });
    }

    function attachRsvpApprovalListeners() {
      document.querySelectorAll<HTMLButtonElement>(".approve-rsvp-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const userId = button.dataset.userId;
          if (!userId || !eventId || !currentUserId) return;

          const qrToken = crypto.randomUUID();

          if (!hasAvailableApprovedSlot(userId)) {
            showActionMessage("This event is already full. Increase the participant limit before approving more RSVPs.", "error");
            return;
          }

          const { error } = await supabase
            .from("event_rsvps")
            .update({
              status: "approved",
              approved_by: currentUserId,
              approved_at: new Date().toISOString(),
              qr_token: qrToken,
            })
            .eq("event_id", eventId)
            .eq("user_id", userId);

          if (error) {
            showActionMessage(error.message, "error");
            return;
          }

          const attendeeEmail =
            getRsvpProfile(
              allRsvps.find((rsvp) => rsvp.user_id === userId)!
            )?.email;

          if (attendeeEmail) {
            await supabase.functions.invoke("send-rsvp-qr", {
              body: {
                email: attendeeEmail,
                eventTitle: currentEvent.title,
                qrToken,
              },
            });
          }

          showActionMessage("RSVP approved.", "success");
          await loadEvent();
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".reject-rsvp-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const userId = button.dataset.userId;
          if (!userId || !eventId) return;

          const { error } = await supabase
            .from("event_rsvps")
            .update({ status: "rejected" })
            .eq("event_id", eventId)
            .eq("user_id", userId);

          if (error) {
            showActionMessage(error.message, "error");
            return;
          }

          showActionMessage("RSVP rejected.", "success");
          await loadEvent();
        });
      });
    }

    copyAllEmailsBtn.addEventListener("click", async () => {
      if (attendeeEmails.length === 0) {
        showCopyMessage("No approved attendee emails to copy.", "error");
        return;
      }

      await copyText(attendeeEmails.join(", "));

      copyAllEmailsBtn.textContent = "Copied";
      setTimeout(() => {
        copyAllEmailsBtn.textContent = "Copy All";
      }, 1200);
    });

    rsvpBtn.addEventListener("click", async () => {
      if (!currentUserId) {
        window.location.href = "/auth/login";
        return;
      }

      if (!currentEvent || currentEvent.created_by === currentUserId) return;

      rsvpBtn.disabled = true;
      rsvpBtn.textContent = "Updating...";

      if (isGoing) {
        const { error } = await supabase
          .from("event_rsvps")
          .update({ status: "cancelled" })
          .eq("event_id", eventId)
          .eq("user_id", currentUserId);

        if (error) {
          showActionMessage(error.message, "error");
          rsvpBtn.disabled = false;
          renderRsvpButton();
          return;
        }

        showActionMessage("RSVP cancelled.", "success");
      } else {
        const newStatus =
          currentEvent.event_type === "private"
            ? "pending"
            : "approved";
        const generatedQrToken =
          newStatus === "approved"
            ? crypto.randomUUID()
            : null;

        if (newStatus === "approved" && !hasAvailableApprovedSlot(currentUserId)) {
          showActionMessage("This event is already full.", "error");
          rsvpBtn.disabled = false;
          renderRsvpButton();
          return;
        }

        const { error } = await supabase
          .from("event_rsvps")
          .upsert(
            {
              event_id: eventId,
              user_id: currentUserId,
              status: newStatus,
              qr_token: generatedQrToken,
            },
            {
              onConflict: "event_id,user_id",
            }
          );

        if (error) {
          showActionMessage(error.message, "error");
          rsvpBtn.disabled = false;
          renderRsvpButton();
          return;
        }

        if (newStatus === "approved") {
          const { data: sessionData } = await supabase.auth.getSession();
          const attendeeEmail = sessionData.session?.user?.email;

          if (attendeeEmail && generatedQrToken) {
            await supabase.functions.invoke("send-rsvp-qr", {
              body: {
                email: attendeeEmail,
                eventTitle: currentEvent.title,
                qrToken: generatedQrToken,
              },
            });
          }
        }

        showActionMessage(
          newStatus === "pending"
            ? "RSVP request sent. The creator must approve it first."
            : "RSVP confirmed successfully.",
          "success"
        );
      }

      rsvpBtn.disabled = false;
      await loadEvent();
    });

    toggleEditBtn.addEventListener("click", () => {
      fillEditForm();

      const wasHidden = editFormWrapper.classList.contains("hidden");

      editFormWrapper.classList.toggle("hidden");

      if (wasHidden) {
        setTimeout(() => {
          editFormWrapper.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }, 100);
      }
    });

    editEventForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!currentEvent || !currentUserId) return;

      const isCreator = currentUserId === currentEvent.created_by;
      const isAdmin = currentUserRole === "admin";
      const canEdit =
        isCreator ||
        (isAdmin && currentEvent.event_type === "official");

      if (!canEdit) {
        showActionMessage("Only the event creator can edit this event. Official events can also be edited by admins.", "error");
        return;
      }

      saveEventBtn.disabled = true;
      saveEventBtn.textContent = "Saving...";

      const updatedEvent = {
        title: editTitle.value.trim(),
        event_type: editEventType.value,
        category: editCategory.value.trim() || null,
        event_date: editDate.value,
        event_time: editTime.value || null,
        location: editLocation.value.trim(),
        participant_limit: editLimit.value ? Number(editLimit.value) : null,
        entry_fee: editFee.value ? Number(editFee.value) : 0,
        description: editDescription.value.trim() || null,
      };

      if (
        updatedEvent.participant_limit !== null &&
        approvedRsvpCount > updatedEvent.participant_limit
      ) {
        saveEventBtn.disabled = false;
        saveEventBtn.textContent = "Save Changes";
        showActionMessage(
          `Participant limit cannot be below the ${approvedRsvpCount} approved RSVP${approvedRsvpCount === 1 ? "" : "s"}.`,
          "error"
        );
        return;
      }

      const { error } = await supabase
        .from("events")
        .update(updatedEvent)
        .eq("id", currentEvent.id);

      saveEventBtn.disabled = false;
      saveEventBtn.textContent = "Save Changes";

      if (error) {
        showActionMessage(error.message, "error");
        return;
      }

      showActionMessage("Event updated successfully.", "success");
      editFormWrapper.classList.add("hidden");
      await loadEvent();
    });

    deleteEventBtn.addEventListener("click", async () => {
      if (!currentEvent || !currentUserId) return;

      const isCreator = currentUserId === currentEvent.created_by;

      if (!isCreator) {
        showActionMessage("Only the event creator can delete this event.", "error");
        return;
      }

      const confirmed = confirm("Are you sure you want to delete this event?");

      if (!confirmed) return;

      const { error } = await supabase
        .from("events")
        .delete()
        .eq("id", currentEvent.id);

      if (error) {
        showActionMessage(error.message, "error");
        return;
      }

      window.location.href = "/explore";
    });

    copyPrivateLinkBtn.addEventListener("click", async () => {
      if (!currentEvent?.private_token) return;

      const link = `${window.location.origin}/events/event_details?id=${currentEvent.id}&token=${currentEvent.private_token}`;
      await navigator.clipboard.writeText(link);

      showActionMessage("Private invite link copied.", "success");
    });

    loadEvent();
  </script>
</Layout>
